interface AbstractFile {
    read(size: int): char[],
    write(data: char[]) : int,
    close() : none,
    seek(offset: int, whence: int) : int,
    tell() : int,
    flush() : none,
    is_eof() : bool,
    size() : int,
    is_seekable() : bool,
    is_readable() : bool,
    is_writable() : bool,
    is_closed() : bool
}