use lang "builtin"
use runtime "runtime"

struct Thread {
    id: unsigned,
    callableObject: func () : none,
    stat: unsigned,
    constructor(callableObject: func () : none),
    start() : lang.Result<unsigned, int>,
    join() : none,
    ping() : int,
}

impl Thread {
    constructor(callableObject: func () : none) {
        this.id = 0
        this.callableObject = callableObject
        this.stat = 0 // not running
    },
    start() : lang.Result<unsigned, int> {
        let result = runtime.runtime_start_thread(this.callableObject)
        if (result.is_ok()) {
            this.id = result.unwrap()
            this.stat = 1 // running
        }
        return result
    },
    join() : none {
        runtime.runtime_thread_join(this.id)
    },
    ping() : int {
        return runtime.runtime_ping_thread(this.id)
    }
}

func current_tid() : unsigned {
    return runtime.runtime_get_thread_id()
}

func hardware_concurrency() : unsigned {
    return runtime.runtime_thread_hardware_concurrency()
}

struct Mutex {
    mutex_handle: unsigned,
    constructor(),
    lock() : none,
    unlock() : none,
    try_lock() : bool,
    finalizer()
}

impl Mutex {
    constructor() {
        this.mutex_handle = runtime.runtime_thread_new_mutex_lock().unwrap()
    },
    lock() : none {
        runtime.runtime_thread_mutex_lock(this.mutex_handle)
    },
    unlock() : none {
        runtime.runtime_thread_mutex_unlock(this.mutex_handle)
    },
    try_lock() : bool {
        let result = runtime.runtime_thread_mutex_try_lock(this.mutex_handle)
        return result == 0
    },
    finalizer() {
        if (this.mutex_handle != 0) {
            runtime.runtime_thread_finalize_mutex_lock(this.mutex_handle)
        }
    }
}

struct Condition {
    condition_handle: unsigned,
    mutex_handle: unsigned,
    constructor(mutex: Mutex),
    constructor(),
    wait() : none,
    signal() : none,
    finalizer()
}

impl Condition {
    constructor(mutex: Mutex) {
        this.condition_handle = runtime.runtime_thread_new_condition().unwrap()
        this.mutex_handle = mutex.mutex_handle
    },
    constructor() {
        this.mutex_handle = runtime.runtime_thread_new_mutex_lock().unwrap()
        this.condition_handle = runtime.runtime_thread_new_condition().unwrap()
    },
    wait() : none {
        runtime.runtime_thread_condition_wait(this.condition_handle, this.mutex_handle)
    },
    signal() : none {
        runtime.runtime_thread_condition_signal(this.condition_handle)
    },
    finalizer() {
        if (this.condition_handle != 0) {
            runtime.runtime_thread_finalize_condition(this.condition_handle)
        }
    }
}