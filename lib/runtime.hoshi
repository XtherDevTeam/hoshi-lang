use lang "builtin"

/* memory management functions */
import noffi intrinsic runtime_get_string_array_data_pointer(arr: char[]) : int from "builtin"

/* C runtime functions */
import strlen(str: ptr) : unsigned from "builtin"
import memcmp(a: ptr, b: ptr, n: int) : int32 from "builtin"
import memcpy(dest: ptr, src: ptr, n: int) : ptr from "builtin"
import puts(str: ptr) : int32 from "builtin"
import runtime_debug_print_int_1(value: int) : none from "builtin"
import fopen(filename: ptr, mode: ptr) : ptr from "builtin"
import fclose(stream: ptr) : int32 from "builtin"
import fread(ptr: ptr, size: int, nmemb: int, stream: ptr) : unsigned from "builtin"
import fseek(stream: ptr, offset: int, whence: int) : unsigned from "builtin"
import ftell(stream: ptr) : int from "builtin"
import fflush(stream: ptr) : int32 from "builtin"
import fwrite(ptr: ptr, size: unsigned, nmemb: unsigned, stream: ptr) : unsigned from "builtin"
import feof(stream: ptr) : int32 from "builtin"
import fgetc(stream: ptr) : int32 from "builtin"
import fputc(c: char, stream: ptr) : int32 from "builtin"

/* runtime thread library */
import noffi runtime_start_thread(f: func () : none) : lang.Result<unsigned, int> from "builtin"
import noffi runtime_thread_join(thread_id: unsigned) : int from "builtin"
import runtime_get_thread_id() : unsigned from "builtin"
import noffi runtime_ping_thread(thread_id: unsigned) : int from "builtin"
import noffi runtime_thread_new_mutex_lock() : lang.Result<unsigned, int> from "builtin"
import noffi runtime_thread_mutex_lock(mutex_id: unsigned) : none from "builtin"
import noffi runtime_thread_mutex_unlock(mutex_id: unsigned) : none from "builtin"
import noffi runtime_thread_finalize_mutex_lock(mutex_id: unsigned) : none from "builtin"
import noffi runtime_thread_mutex_try_lock(mutex_id: unsigned) : int from "builtin"
import noffi runtime_thread_new_condition() : lang.Result<unsigned, int> from "builtin"
import noffi runtime_thread_condition_wait(condition_id: unsigned, mutex_id: unsigned) : none from "builtin"
import noffi runtime_thread_condition_signal(condition_id: unsigned) : none from "builtin"
import noffi runtime_thread_finalize_condition(condition_id: unsigned) : none from "builtin"

/* stdin/stdout/stderr */
import runtime_get_stdin_fp() : ptr from "builtin"
import runtime_get_stdout_fp() : ptr from "builtin"
import runtime_get_stderr_fp() : ptr from "builtin"

/* legacy random library */

import runtime_random_legacy_set_seed(seed: unsigned) : none from "builtin"
import runtime_random_legacy_unsigned() : unsigned from "builtin"

/* signal library */

import runtime_signal_init() : none from "builtin"
import noffi runtime_signal_register(signum: int, handler: func (int) : none) : int from "builtin"
import runtime_signal_alarm(seconds: int32) : int32 from "builtin"
import runtime_signal_raise(signum: int32) : int32 from "builtin"
import runtime_signal_default(signum: int32) : int32 from "builtin"
import runtime_signal_ignore(signum: int32) : int32 from "builtin"

/* file system library */

import runtime_fs_exists(path: ptr) : bool from "builtin"
import runtime_fs_isfile(path: ptr) : bool from "builtin"
import runtime_fs_isdir(path: ptr) : bool from "builtin"

import runtime_fs_get_mtime(path: ptr) : int from "builtin"
import runtime_fs_get_size(path: ptr) : unsigned from "builtin"
import runtime_fs_get_ctime(path: ptr) : int from "builtin"
import runtime_fs_get_atime(path: ptr) : int from "builtin"
import runtime_fs_get_uid(path: ptr) : int32 from "builtin"

import runtime_fs_temp_dir() : ptr from "builtin"
import runtime_fs_home_dir() : ptr from "builtin"
import runtime_fs_cwd() : ptr from "builtin"
import runtime_fs_realpath(path: ptr) : ptr from "builtin"
import runtime_fs_mkdir(path: ptr, mode: int) : bool from "builtin"
import runtime_fs_rmdir(path: ptr) : bool from "builtin"
import runtime_fs_remove(path: ptr) : bool from "builtin"
import runtime_fs_rename(oldpath: ptr, newpath: ptr) : bool from "builtin"
import runtime_fs_opendir(path: ptr) : ptr from "builtin"
import runtime_fs_readdir(dirp: ptr) : ptr from "builtin"
import runtime_fs_closedir(dirp: ptr) : int from "builtin"
import runtime_fs_symlink(src_path: ptr, dst_path: ptr) : bool from "builtin"

import runtime_fs_finalize(res: ptr) : none from "builtin"