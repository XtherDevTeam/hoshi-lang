use str "str"
use runtime "runtime"

struct Time {
    seconds: int,
    nanoseconds: int,
    constructor(seconds: int, nanoseconds: int)
}

impl Time {
    constructor(seconds: int, nanoseconds: int) {
        this.seconds = seconds
        this.nanoseconds = nanoseconds
    }
}

import noffi runtime_time_now() : Time from "builtin"
import noffi runtime_time_monotonic_now() : Time from "builtin"
import runtime_time_sleep(seconds: int, nanoseconds: int) : none from "builtin"
import runtime_time_strftime(format: ptr, seconds: int, nanoseconds: int) : ptr from "builtin"
import runtime_time_localtimezone_offset() : int from "builtin"
import runtime_time_finalize(memory: ptr) : none from "builtin"

struct Duration {
    time: Time,
    constructor(time: Time),
    static days(days: int) : Duration,
    static hours(hours: int) : Duration,
    static minutes(minutes: int) : Duration,
    static seconds(seconds: int) : Duration,
    static milliseconds(milliseconds: int) : Duration,
    static microseconds(microseconds: int) : Duration,
    static nanoseconds(nanoseconds: int) : Duration,
    static operator+(duration: Duration, duration2: Duration) : Duration,
    static operator-(duration: Duration, duration2: Duration) : Duration,
    static operator+=(duration: Duration, duration2: Duration) : Duration,
    static operator-=(duration: Duration, duration2: Duration) : Duration,
    format(format: str.Str) : str.Str,
    sleep() : none,
    static monotonic_now() : Duration,
    static timezone() : Duration
}

struct Date {
    time: Time,
    constructor(time: Time),
    static now() : Date,
    static from_timestamp(timestamp: int) : Date,
    static date(year: int, month: int, day: int) : Date,
    static operator+(date: Date, duration: Duration) : Date,
    static operator-(date: Date, duration: Duration) : Date,
    static operator+=(date: Date, duration: Duration) : Date,
    static operator-=(date: Date, duration: Duration) : Date,
    format(format: str.Str) : str.Str
}

impl Duration {
    constructor(time: Time) {
        this.time = time
    },
    static days(days: int) : Duration {
        return Duration(Time(days * 24 * 60 * 60, 0))
    },
    static hours(hours: int) : Duration {
        return Duration(Time(hours * 60 * 60, 0))
    },
    static minutes(minutes: int) : Duration {
        return Duration(Time(minutes * 60, 0))
    },
    static seconds(seconds: int) : Duration {
        return Duration(Time(seconds, 0))
    },
    static milliseconds(milliseconds: int) : Duration {
        return Duration(Time(milliseconds / 1000, (milliseconds % 1000) * 1000))
    },
    static microseconds(microseconds: int) : Duration {
        return Duration(Time(microseconds / 1000000, (microseconds % 1000000) * 1000))
    },
    static nanoseconds(nanoseconds: int) : Duration {
        return Duration(Time(nanoseconds / 1000000000, (nanoseconds % 1000000000) * 1000))
    },
    static operator+(duration: Duration, duration2: Duration) : Duration {
        return Duration(Time(duration.time.seconds + duration2.time.seconds, duration.time.nanoseconds + duration2.time.nanoseconds))
    },
    static operator-(duration: Duration, duration2: Duration) : Duration {
        return Duration(Time(duration.time.seconds - duration2.time.seconds, duration.time.nanoseconds - duration2.time.nanoseconds))
    },
    static operator+=(duration: Duration, duration2: Duration) : Duration {
        duration.time.seconds += duration2.time.seconds
        duration.time.nanoseconds += duration2.time.nanoseconds
        return duration
    },
    static operator-=(duration: Duration, duration2: Duration) : Duration {
        duration.time.seconds -= duration2.time.seconds
        duration.time.nanoseconds -= duration2.time.nanoseconds
        return duration
    },
    format(format: str.Str) : str.Str {
        let p = runtime_time_strftime(runtime.runtime_get_string_array_data_pointer(format.data), this.time.seconds, this.time.nanoseconds)
        let s = str.Str.from_c_str(p)
        runtime_time_finalize(p)
        return s
    },
    sleep() : none {
        runtime_time_sleep(this.time.seconds, this.time.nanoseconds)
    },
    static monotonic_now() : Duration {
        return Duration(runtime_time_monotonic_now())
    },
    static timezone() : Duration {
        return Duration(Time(runtime_time_localtimezone_offset(), 0))
    }
}

impl Date {
    constructor(time: Time) {
        this.time = time
    },
    static now() : Date {
        return Date(runtime_time_now())
    },
    static from_timestamp(timestamp: int) : Date {
        return Date(Time(timestamp, 0))
    },
    static date(year: int, month: int, day: int) : Date {
        let days_in_month = new int[12](31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
        let timestamp_result = 0
        for (let i = 1970; i < year; i += 1) {
            if (i % 4 == 0 && i % 100 != 0 || i % 400 == 0) {
                timestamp_result += 366
            } else {
                timestamp_result += 365
            }
        }
        for (let i = 1; i < month; i += 1) {
            timestamp_result += days_in_month[i - 1]
            if (i == 2 && (year % 4 == 0 && year % 100 != 0 || year % 400 == 0)) {
                timestamp_result += 1
            }
        }
        timestamp_result += (day - 1)
        return Date(Time(timestamp_result * 24 * 60 * 60, 0))
    },
    static operator+(date: Date, duration: Duration) : Date {
        return Date(Time(date.time.seconds + duration.time.seconds, date.time.nanoseconds + duration.time.nanoseconds))
    },
    static operator-(date: Date, duration: Duration) : Date {
        return Date(Time(date.time.seconds - duration.time.seconds, date.time.nanoseconds - duration.time.nanoseconds))
    },
    static operator+=(date: Date, duration: Duration) : Date {
        date.time.seconds += duration.time.seconds
        date.time.nanoseconds += duration.time.nanoseconds
        return date
    },
    static operator-=(date: Date, duration: Duration) : Date {
        date.time.seconds -= duration.time.seconds
        date.time.nanoseconds -= duration.time.nanoseconds
        return date
    },
    static format(format: str.Str) : str.Str {
        let p = runtime_time_strftime(runtime.runtime_get_string_array_data_pointer(format.data), this.time.seconds, this.time.nanoseconds)
        let s = str.Str.from_c_str(p)
        runtime_time_finalize(p)
        return s
    }
}

impl Date : str.Stringable {
    to_string() : str.Str {
        return this.format("%Y-%m-%d %H:%M:%S")
    }
}

impl Duration : str.Stringable {
    to_string() : str.Str {
        return this.format("%H:%M:%S")
    }
}