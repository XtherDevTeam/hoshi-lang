use lang "builtin"
use math "math"
use runtime "runtime"

struct Str {
    data: char[],
    length: unsigned,
    capacity: unsigned,
    push(ch: char) : none,
    pop() : none,
    size() : int,
    clear() : none,
    capacity_resize(new_capacity: unsigned) : none,
    shrink_to_fit() : none,
    startswith(prefix: Str) : bool,
    endswith(suffix: Str) : bool,
    c_str() : int,
    find(pattern: Str, start: int) : int,
    find(ch: char, start: int) : int,
    always_inline find(ch: char) : int,
    always_inline find(pattern: Str) : int,
    substring(start: unsigned, end: unsigned) : Str,
    trim() : Str,
    replace(pattern: Str, value: Str) : Str,
    split(sep: Str) : Str[],
    split(sep: string) : Str[],
    find_all(pattern: Str) : int,
    reverse() : none,
    always_inline substring(start: int, end: int) : Str,
    static join(strs: Str[]) : Str,
    static join(args: ...) : Str,
    constructor(literal: string),
    constructor(arr: char[]),
    constructor(capacity: unsigned),
    static from_c_str(c_str: unsigned) : Str,
    lowercase() : Str,
    uppercase() : Str,
    constructor(),
    static operator+(a: Str, b: Str) : Str,
    static operator+(a: Str, b: string) : Str,
    static operator+(a: string, b: Str) : Str,
    static operator+(a: Str, b: char) : Str,
    static operator==(a: Str, b: Str) : bool,
    static operator==(a: Str, b: string) : bool,
    static operator==(a: string, b: Str) : bool,
    static operator!=(a: Str, b: Str) : bool,
    static operator!=(a: Str, b: string) : bool,
    static operator!=(a: string, b: Str) : bool,
    static operator[](self: Str, index: int) : char,
    static operator[](value: char, self: Str, index: int) : none,
    static operator+=(a: Str, b: Str) : Str,
    static operator+=(a: Str, b: char[]) : Str
}

impl Str {
    constructor(literal: string) {
        this.length = runtime.strlen(literal)
        this.capacity = this.length + 1
        this.data = new char[this.capacity]()
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(this.data), literal, this.length)
        this.data[this.length] = '\0'
    },
    constructor(arr: char[]) {
        this.length = arr.length
        this.data = arr
        this.capacity = this.length + 1
    },
    constructor(capacity: unsigned) {
        if (capacity < 1u) {
            capacity = 1u
        }
        this.length = 0u
        this.capacity = capacity
        this.data = new char[capacity]()
        this.data[0] = '\0'
    },
    constructor() {
        this.length = 0u
        this.capacity = 1u
        this.data = new char[1]()
        this.data[0] = '\0'
    },
    capacity_resize(new_capacity: unsigned) : none {
        if (new_capacity <= this.capacity) {
            return
        }
        let new_data = new char[new_capacity]()
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_data), runtime.runtime_get_string_array_data_pointer(this.data), this.length)
        this.data = new_data
        this.capacity = new_capacity
    },
    push(ch: char) : none {
        if (this.length == this.capacity) {
            this.capacity_resize(this.capacity * 2u)
        }
        this.data[this.length] = ch
        this.length += 1
        this.data[this.length] = '\0'
    },
    pop() : none {
        if (this.length == 0u) {
            return
        }
        this.length -= 1u
        this.data[this.length] = '\0'
    },
    size() : int {
        return this.length
    },
    clear() : none {
        this.length = 0u
        this.data[0] = '\0'
    },
    shrink_to_fit() : none {
        if (this.length == this.capacity) {
            return
        }
        let new_data = new char[this.length + 1u]()
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_data), runtime.runtime_get_string_array_data_pointer(this.data), this.length)
        this.data = new_data
        this.capacity = this.length + 1
    },
    startswith(prefix: Str) : bool {
        if (prefix.length > this.length) {
            return false
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(this.data), runtime.runtime_get_string_array_data_pointer(prefix.data), prefix.length) == 0
    },
    endswith(suffix: Str) : bool {
        if (suffix.length > this.length) {
            return false
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(this.data) + this.length - suffix.length, runtime.runtime_get_string_array_data_pointer(suffix.data), suffix.length) == 0
    },
    static operator+(a: Str, b: Str) : Str {
        let new_str = Str(a.length + b.length)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data), runtime.runtime_get_string_array_data_pointer(a.data), a.length)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data) + a.length, runtime.runtime_get_string_array_data_pointer(b.data), b.length)
        new_str.data[a.length + b.length] = '\0'
        new_str.length = a.length + b.length
        return new_str
    },
    static operator+(a: Str, b: string) : Str {
        let new_str = Str(a.length + runtime.strlen(b))
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data), runtime.runtime_get_string_array_data_pointer(a.data), a.length)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data) + a.length, b, runtime.strlen(b))
        new_str.data[a.length + runtime.strlen(b)] = '\0'
        new_str.length = a.length + runtime.strlen(b)
        return new_str
    },
    static operator+(a: Str, b: char) : Str {
        let new_str = Str(a.length + 1u)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data), runtime.runtime_get_string_array_data_pointer(a.data), a.length)
        new_str.data[a.length] = b
        new_str.data[a.length + 1] = '\0'
        new_str.length = a.length + 1
        return new_str
    },
    static operator+(a: string, b: Str) : Str {
        let new_str = Str(runtime.strlen(a) + b.length)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data), a, runtime.strlen(a))
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data) + runtime.strlen(a), runtime.runtime_get_string_array_data_pointer(b.data), b.length)
        new_str.data[runtime.strlen(a) + b.length] = '\0'
        new_str.length = runtime.strlen(a) + b.length
        return new_str
    },
    static operator==(a: Str, b: Str) : bool {
        if (a.length != b.length) {
            return false
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(a.data), runtime.runtime_get_string_array_data_pointer(b.data), a.length) == 0
    },
    static operator==(a: Str, b: string) : bool {
        if (a.length != runtime.strlen(b)) {
            return false
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(a.data), b, a.length) == 0
    },
    static operator==(a: string, b: Str) : bool {
        if (runtime.strlen(a) != b.length) {
            return false
        }
        return runtime.memcmp(a, runtime.runtime_get_string_array_data_pointer(b.data), b.length) == 0
    },
    static operator!=(a: Str, b: Str) : bool {
        if (a.length != b.length) {
            return true
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(a.data), runtime.runtime_get_string_array_data_pointer(b.data), a.length) != 0
    },
    static operator!=(a: Str, b: string) : bool {
        if (a.length != runtime.strlen(b)) {
            return true
        }
        return runtime.memcmp(runtime.runtime_get_string_array_data_pointer(a.data), b, a.length) != 0
    },
    static operator!=(a: string, b: Str) : bool {
        if (runtime.strlen(a) != b.length) {
            return true
        }
        return runtime.memcmp(a, runtime.runtime_get_string_array_data_pointer(b.data), b.length) != 0
    },
    static operator[](self: Str, index: int) : char {
        if (index < 0 || index >= self.length) {
            return '\0'
        }
        return self.data[index]
    },
    static operator[](value: char, self: Str, index: int) : none {
        if (index < 0 || index >= self.length) {
            return
        }
        self.data[index] = value
    },
    c_str() : int {
        return runtime.runtime_get_string_array_data_pointer(this.data)
    },
    find(pattern: Str, start: int) : int {
        if (pattern.length > this.length) {
            return -1
        }
        // a simple implementation of Knuth-Morris-Pratt algorithm
        // build next array
        let next = new int[pattern.length](0)
        let prefix_length = 0
        let i = 1
        while (i < pattern.length) {
            if (pattern[i] == pattern[prefix_length]) {
                prefix_length += 1
                next[i] = prefix_length
                i += 1
            } else {
                if (prefix_length == 0) {
                    next[i] = 0
                    i += 1
                } else {
                    prefix_length = next[prefix_length - 1]
                }
            }
        }
        // search
        i = start
        let j = 0
        while (i < this.length) {
            if (this[i] == pattern[j]) {
                i += 1
                j += 1
            } elif (j > 0) {
                j = next[j - 1]
            } else {
                i += 1
            }
            if (j == pattern.length) {
                return i - j
            }
        }
        return -1
    },
    find_all(pattern: Str) : int {
        let occurences = 0
        let index = 0
        let index_after_last_sep = 0
        while (index != -1) {
            index = this.find(pattern, index_after_last_sep)
            if (index != -1) {
                occurences += 1
                index_after_last_sep = index + pattern.length
            }
        }
        return occurences
    },
    always_inline find(pattern: Str) : int {
        return this.find(pattern, 0)
    },
    substring(start: unsigned, end: unsigned) : Str {
        let new_str = Str(end - start)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data), runtime.runtime_get_string_array_data_pointer(this.data) + start, end - start)
        new_str.data[end - start] = '\0'
        new_str.length = end - start
        return new_str
    },
    always_inline substring(start: int, end: int) : Str {
        return this.substring(start as unsigned, end as unsigned)
    },
    join(strs: Str[]) : Str {
        let total_length = 0u
        for (let i = 0; i < strs.length; i += 1) {
            total_length += strs[i].length
        }
        let new_str = Str(total_length)
        let offset = 0
        for (let i = 0; i < strs.length; i += 1) {
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(new_str.data) + offset, runtime.runtime_get_string_array_data_pointer(strs[i].data), strs[i].length)
            offset += strs[i].length
        }
        new_str.data[total_length] = '\0'
        new_str.length = total_length
        return new_str
    },
    join(args: ...) : Str {
        let strs = new Str[args.length]()
        for (let i = 0; i < args.length; i += 1) {
            if (args[i] interfaceof Str) {
                strs[i] = dyn_cast<Str>(args[i])
            } elif (args[i] interfaceof string) {
                strs[i] = Str(dyn_cast<string>(args[i]))
            }
        }
        return Str.join(strs)
    },
    trim() : Str {
        let start = 0u
        let end = this.length
        while (start < end && this.data[start] <= ' ') {
            start += 1
        }
        while (end > start && this.data[end - 1] <= ' ') {
            end -= 1
        }
        return this.substring(start, end)
    },
    replace(pattern: Str, value: Str) : Str {
        let occur = this.find_all(pattern) as unsigned
        if (occur == 0u) {
            return this
        }

        let res = Str(this.length - pattern.length * occur + value.length * occur)
        let index = this.find(pattern) as unsigned // the index of occurrence of pattern
        let index_after_last_pattern = 0u // fuck it, while 0 become 0u, it tell me index not exist
        let offset = 0u // the current offset in res.data

        let res_data_ptr = runtime.runtime_get_string_array_data_pointer(res.data)
        let this_data_ptr = runtime.runtime_get_string_array_data_pointer(this.data)
        let value_data_ptr = runtime.runtime_get_string_array_data_pointer(value.data)

        while (index != -1) {
            // copy the part before the pattern
            runtime.memcpy(res_data_ptr + offset, this_data_ptr + index_after_last_pattern, index - index_after_last_pattern)
            offset += index - index_after_last_pattern
            // copy the value
            runtime.memcpy(res_data_ptr + offset, value_data_ptr, value.length)
            offset += value.length
            index_after_last_pattern = index + pattern.length
            index = this.find(pattern, index_after_last_pattern as int)
        }
        // copy the part after the last pattern
        runtime.memcpy(res_data_ptr + offset, this_data_ptr + index_after_last_pattern, this.length - index_after_last_pattern)
        res.length = this.length - pattern.length * occur + value.length * occur
        res.data[res.length] = '\0'
        return res
    },
    split(sep: Str) : Str[] {
        let occurences = this.find_all(sep) + 1
        let res = new Str[occurences]()
        let index = 0u
        let index_after_last_sep = 0u
        let offset = 0u
        for (let i = 0; i < occurences + 1; i += 1) {
            index = this.find(sep, index_after_last_sep + 1)
            if (index != -1) {
                res[i] = this.substring(offset, index)
                offset = index + sep.length
                index_after_last_sep = index
            } else {
                res[i] = this.substring(offset, this.length)
            }
        }
        return res
    },
    split(sep: string) : Str[] {
        return this.split(Str(sep))
    },
    reverse() : none {
        let left = 0u
        let right = this.length - 1u
        while (left < right) {
            let temp = this.data[left]
            this.data[left] = this.data[right]
            this.data[right] = temp
            left += 1
            right -= 1
        }
    },
    find(ch: char, start: int) : int {
        for (let i = start; i < this.length; i += 1) {
            if (this.data[i] == ch) {
                return i
            }
        }
        return -1
    },
    always_inline find(ch: char) : int {
        return this.find(ch, 0)
    },
    static from_c_str(c_str: unsigned) : Str {
        let length = runtime.strlen(c_str) as unsigned
        let res = Str(length + 1u)
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(res.data), c_str, length)
        res.length = length
        res.data[length] = '\0'
        return res
    },
    lowercase() : Str {
        for (let i = 0; i < this.length; i += 1) {
            if (this.data[i] >= 'A' && this.data[i] <= 'Z') {
                this.data[i] = this.data[i] - 'A' + 'a'
            }
        }
        return this
    },
    uppercase() : Str {
        for (let i = 0; i < this.length; i += 1) {
            if (this.data[i] >= 'a' && this.data[i] <= 'z') {
                this.data[i] = this.data[i] - 'a' + 'A'
            }
        }
        return this
    },
    static operator+=(a: Str, b: Str) : Str {
        if (a.capacity < a.length + b.length) {
            a.capacity_resize((a.length + b.length) * 2u)
        }
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(a.data) + a.length, runtime.runtime_get_string_array_data_pointer(b.data), b.length)
        a.length += b.length
        a.data[a.length] = '\0'
        return a
    },
    static operator+=(a: Str, b: char[]) : Str {
        if (a.capacity < a.length + runtime.strlen(runtime.runtime_get_string_array_data_pointer(b))) {
            a.capacity_resize((a.length + runtime.strlen(runtime.runtime_get_string_array_data_pointer(b))) * 2u)
        }
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(a.data) + a.length, runtime.runtime_get_string_array_data_pointer(b), runtime.strlen(runtime.runtime_get_string_array_data_pointer(b)))
        a.length += runtime.strlen(runtime.runtime_get_string_array_data_pointer(b))
        a.data[a.length] = '\0'
        return a
    }
}

impl Str : lang.Hashable {
    hash() : int {
        let res = 0
        for (let i = 0; i < this.length; i += 1) {
            res = (res * 31 + this.data[i]) & 0xffffffff
        }
        return res
    }
}

interface Stringable {
    to_string() : Str
}

impl int : Stringable {
    to_string() : Str {
        let x = math.abs(this)
        if (x == 0) {
            return "0"
        }
        let res = Str(24u)
        let is_negative = this < 0
        while (x > 0) {
            let digit = (x % 10) as char
            res.push(digit + '0')
            x /= 10
        }
        if (is_negative) {
            res.push('-')
        }
        res.reverse()
        return res
    }
}

impl bool : Stringable {
    to_string() : Str {
        if (this) {
            return Str("true")
        } else {
            return Str("false")
        }
    }
}

impl string : Stringable {
    to_string() : Str {
        return Str(this)
    }
}

impl Str : Stringable {
    to_string() : Str {
        return this
    }
}

impl char : Stringable {
    to_string() : Str {
        let res = Str(2u)
        res.length = 1u
        res.data[0] = this
        return res
    }
}

struct Hex {
    value : int,
    constructor(value: int)
}

impl Hex {
    constructor(value: int) {
        this.value = value
    }
}

impl Hex : Stringable {
    to_string() : Str {
        let res = Str(16u)
        if (this.value == 0) {
            return "0"
        }
        let is_negative = this.value < 0
        if (is_negative) {
            this.value = -this.value
        }
        let hex_chars : Str = "0123456789ABCDEF"
        while (this.value > 0) {
            let digit = (this.value % 16) as char
            res.push(hex_chars[digit])
            this.value /= 16
        }
        if (is_negative) {
            res.push('-')
        }
        res.reverse()
        return res
    }
}

func format(fmt: Str, args: ...Stringable[]) : Str {
    let occur = fmt.find_all(Str("{}"))
    if (occur == 0u) {
        return fmt
    }
    let strs = new Str[args.length]()
    let total_strs_length = 0u
    for (let i = 0; i < args.length; i += 1) {
        strs[i] = args[i].to_string()
        total_strs_length += strs[i].length
    }
    let index_after_last_pattern = 0u
    let index = fmt.find(Str("{}"), index_after_last_pattern as int)
    let offset = 0u
    let res = Str(fmt.length + total_strs_length - occur as unsigned * 2u + 1u)
    let res_data_ptr = runtime.runtime_get_string_array_data_pointer(res.data)
    let fmt_data_ptr = runtime.runtime_get_string_array_data_pointer(fmt.data)

    for (let current_arg = 0u; current_arg < occur && current_arg < args.length; current_arg += 1) {
        // copy the part before the pattern
        runtime.memcpy(res_data_ptr + offset, fmt_data_ptr + index_after_last_pattern, index - index_after_last_pattern)
        offset += index - index_after_last_pattern
        index_after_last_pattern = index + 2u
        index = fmt.find(Str("{}"), index_after_last_pattern as int)
        // copy the value
        runtime.memcpy(res_data_ptr + offset, runtime.runtime_get_string_array_data_pointer(strs[current_arg].data), strs[current_arg].length)
        offset += strs[current_arg].length
    }
    // copy the part after the last pattern
    runtime.memcpy(res_data_ptr + offset, fmt_data_ptr + index_after_last_pattern, fmt.length - index_after_last_pattern)
    res.length = fmt.length + total_strs_length - occur * 2u
    res.data[res.length] = '\0'
    return res
}

func join(sep: Str, args: Str[]) : Str {
    let total_length = 0u
    for (let i = 0; i < args.length; i += 1) {
        total_length += args[i].length
    }
    total_length += (args.length - 1u) * sep.length
    let res = Str(total_length + 1u)
    let offset = 0u
    for (let i = 0; i < args.length; i += 1) {
        runtime.memcpy(runtime.runtime_get_string_array_data_pointer(res.data) + offset, runtime.runtime_get_string_array_data_pointer(args[i].data), args[i].length)
        offset += args[i].length
        if (i != args.length - 1u) {
            runtime.memcpy(runtime.runtime_get_string_array_data_pointer(res.data) + offset, runtime.runtime_get_string_array_data_pointer(sep.data), sep.length)
            offset += sep.length
        }
    }
    res.data[total_length] = '\0'
    res.length = total_length
    return res
}

func join(sep: Str, args: ...Stringable) : Str {
    let collected_args = new Str[args.length]()
    for (let i = 0; i < args.length; i += 1) {
        collected_args[i] = args[i].to_string()
    }
    return join(sep, collected_args)
}

func always_inline toInt(s: Str) : int {
    let i = 0
    let len = s.length
    let acc = 0
    let is_negative = false
    let base = 0

    if (i < len) {
        if (s[i] == '-') {
            is_negative = true
            i += 1
        } elif (s[i] == '+') {
            i += 1
        }
    }

    // 2. Handle base prefix (e.g., '0x' for hex).
    // If base is 0, allow 0x for hex and 0 for octal.
    // If base is 16, allow 0x.
    if ((base == 0 || base == 16) &&
        i + 1 < len && s[i] == '0' && (s[i+1] == 'x' || s[i+1] == 'X')) {
        i += 2
        base = 16
    }
    
    if (base == 0) {
        if (i < len && s[i] == '0') {
            base = 8
        } else {
            base = 10
        }
    }

    while (i < len) {
        let c = s[i]
        let digit = -1

        if (c >= '0' && c <= '9') {
            digit = c - '0'
        } elif (c >= 'a' && c <= 'z') {
            digit = c - 'a' + 10
        } elif (c >= 'A' && c <= 'Z') {
            digit = c - 'A' + 10
        }

        if (digit == -1 || digit >= base) {
            break
        }
        
        acc = acc * base + digit
        i += 1
    }

    if (is_negative) {
        acc = -acc
    }

    if (i != len) {
        return 0 // invalid character
    }

    return acc
}

func always_inline toInt(s: string) : int {
    return toInt(Str(s))
}

func always_inline toDeci(s: Str) : deci {
    let res = 0.0
    let is_negative = false
    let start = 0
    let decimal_point_found = false
    let decimal_place = 1.0

    if (s.length == 0) {
        return 0.0
    }

    if (s[0] == '-') {
        is_negative = true
        start = 1
    }

    for (let i = start; i < s.length; i += 1) {
        if (s[i] >= '0' && s[i] <= '9') {
            if (decimal_point_found) {
                decimal_place /= 10.0
                res += (s[i] - '0') * decimal_place
            } else {
                res = res * 10.0 + (s[i] - '0')
            }
        } elif (s[i] == '.' && decimal_point_found == false) {
            decimal_point_found = true
        } else {
            return 0.0 // Invalid character
        }
    }

    if (is_negative) {
        res = -res
    }
    return res
}

func always_inline toDeci(s: string) : deci {
    return toDeci(Str(s))
}

func escape(s: Str) : Str {
    let res = Str(s.length * 2u + 1u)
    for (let i = 0; i < s.length; i += 1) {
        if (s[i] == '\"') {
            res.push('\\')
            res.push('\"')
        } elif (s[i] == '\\') {
            res.push('\\')
            res.push('\\')
        } elif (s[i] == '\n') {
            res.push('\\')
            res.push('n')
        } elif (s[i] == '\r') {
            res.push('\\')
            res.push('r')
        } elif (s[i] == '\t') {
            res.push('\\')
            res.push('t')
        } else {
            res.push(s[i])
        }
    }
    return res
}