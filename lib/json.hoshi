use str "str"
use hashMap "hashMap"
use file "file"
use lang "builtin"
use io "io"
use runtime "runtime"
use vec "vec"

/* 
   BUFFERED STREAM 
   A zero-copy-style wrapper around AbstractFile. 
   It enables lookahead (peek) without seeking the underlying OS file.
*/

struct BufferedStream {
    file: file.AbstractFile,
    buffer: char[],
    buf_size: int,
    buf_capacity: int,
    cursor: int,      // Index within the current buffer
    abs_pos: int,     // Absolute position in file of the start of the buffer
    mark_pos: int,
    constructor(f: file.AbstractFile),
    always_inline peek() : char,
    always_inline advance() : char,
    seek_rel(offset: int) : none,
    extract_str(length: int) : str.Str,
    fill_buffer() : none,
    set_mark() : none,
    unset_mark() : none,
    rewind_to_mark() : none
}

impl BufferedStream {
    constructor(f: file.AbstractFile) {
        this.file = f
        this.buf_capacity = 4096 // 4KB chunks
        this.buffer = new char[this.buf_capacity]()
        this.buf_size = 0
        this.cursor = 0
        this.abs_pos = 0
        this.mark_pos = -1
        this.fill_buffer()
    },
    fill_buffer() : none {
        let preserve_start = 0
        let preserve_len = 0
        
        if (this.mark_pos >= 0 && this.mark_pos < this.buf_size) {
            preserve_start = this.mark_pos
            preserve_len = this.buf_size - preserve_start
        }
        
        let dest_ptr = runtime.runtime_get_string_array_data_pointer(this.buffer)
        
        // Move preserved data to start if needed
        if (preserve_len > 0) {
            runtime.memcpy(
                dest_ptr, 
                dest_ptr + preserve_start, 
                preserve_len
            )
        }
        
        // Read new data
        let to_read = this.buf_capacity - preserve_len
        let read_struct = this.file.read(to_read)
        
        if (read_struct.size > 0) {
            runtime.memcpy(
                dest_ptr + preserve_len, 
                runtime.runtime_get_string_array_data_pointer(read_struct.data), 
                read_struct.size
            )
        }
        
        this.buf_size = preserve_len + read_struct.size
        
        // Adjust cursor and mark
        if (this.mark_pos >= 0) {
            this.cursor -= this.mark_pos
            this.mark_pos = 0
            // abs_pos follows cursor logic, so it remains valid relative to the file stream
            // if we consider abs_pos as the "virtual" file position.
            // But if we shifted data, the byte at buffer[0] is now the byte at old buffer[mark_pos].
            // If abs_pos tracks cursor, it is fine.
        } else {
            this.cursor = 0
            // If strictly forward (no mark), we effectively consumed everything.
        }
    },
    always_inline peek() : char {
        if (this.cursor >= this.buf_size) {
            this.fill_buffer()
        }
        if (this.buf_size == 0) {
            return '\0'
        }
        return this.buffer[this.cursor]
    },
    always_inline advance() : char {
        let c = this.peek()
        if (c != '\0') {
            this.cursor += 1
            this.abs_pos += 1
        }
        return c
    },
    seek_rel(offset: int) : none {
        if (this.cursor + offset >= this.buf_size) {
             // Basic safe implementation: loop advance
             // This ensures refill triggers correctly and marks are respected if active
             for (let i = 0; i < offset; i += 1) {
                 this.advance()
             }
        } else {
            this.cursor += offset
            this.abs_pos += offset
        }
    },
    set_mark() : none {
        this.mark_pos = this.cursor
    },
    unset_mark() : none {
        this.mark_pos = -1
    },
    rewind_to_mark() : none {
        if (this.mark_pos >= 0) {
            this.cursor = this.mark_pos
            // abs_pos should be updated to match cursor?
            // If abs_pos tracks cursor, we simply assume it must be recalculated or kept in sync?
            // advance() maintains abs_pos.
            // If we rewind relative to buffer, we don't easily know the abs_pos decrement 
            // unless we track it.
            // But Numeric doesn't use abs_pos for logic, only for potential length calc?
            // Actually Numeric uses len = cursor - start_idx.
            // If we rewind, abs_pos is de-synced?
            // "abs_pos += 1" in advance.
            // If we rewind, we should decrement abs_pos?
            // We don't verify abs_pos correctness in Numeric logic, but for general correctness:
            // this.abs_pos -= (old_cursor - new_cursor)
            // But checking old cursor `this.cursor` vs `this.mark_pos`.
            let diff = this.cursor - this.mark_pos
            this.abs_pos -= diff
        }
    },
    extract_str(length: int) : str.Str {
        let s = str.Str((length + 1) as unsigned)
        runtime.memcpy(
            runtime.runtime_get_string_array_data_pointer(s.data),
            runtime.runtime_get_string_array_data_pointer(this.buffer) + this.cursor, 
            length
        )
        s.length = length as unsigned
        s.data[length] = '\0'
        
        this.cursor += length
        this.abs_pos += length
        return s
    }
}

impl BufferedStream : file.AbstractFile {
    /* AbstractFile Implementation Proxies */
    read(size: int): file.ReadBufferView { return this.file.read(size) },
    write(data: char[]) : int { return this.file.write(data) + 0 },
    write(data: char[], size: int) : int { return this.file.write(data, size) + 0 },
    write(data: char[], start: int, size: int) : int { return this.file.write(data, start, size) + 0 },
    close() : none { this.file.close() },
    seek(offset: int, whence: int) : int { return this.file.seek(offset, whence) + 0 },
    tell() : int { return this.abs_pos + 0 }, /* Return tracked abs_pos */
    flush() : none { this.file.flush() },
    is_eof() : bool { return this.file.is_eof() == true },
    size() : int { return this.file.size() + 0 },
    is_seekable() : bool { return this.file.is_seekable() == true },
    is_readable() : bool { return this.file.is_readable() == true },
    is_writable() : bool { return this.file.is_writable() == true },
    is_closed() : bool { return this.file.is_closed() == true },
    getch() : char { return this.advance() + '\0' },
    putch(c: char) : none { this.file.putch(c) }
}

interface JSONValue {
    to_string(): str.Str,
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, str.Str>
}

interface JSONSerializable {
    to_json() : JSONValue
}

interface JSONDeserializable {
    from_json(json: JSONValue) : lang.Result<JSONValue, str.Str>
}

alias JSONDict = hashMap.HashMap<str.Str, JSONValue>

alias JSONList = vec.Vec<JSONValue>

struct JSONNull {
    to_string() : str.Str,
    constructor()
}

struct Numeric {
    type: unsigned, /* 0 = int, 1 = decimal */
    data: str.Str,
    getInt() : int,
    getDecimal() : deci,
    constructor(type: unsigned, data: str.Str),
    constructor(),
    constructor(i: int)
}

struct JSONParser {
    static skip_whitespace_buffered(s: BufferedStream) : none,
    static parse_internal_dispatch(stream: BufferedStream) : lang.Result<JSONValue, str.Str>,
    static parse_string_internal(stream: BufferedStream) : lang.Result<JSONValue, str.Str>
}

/* forward-declaration */

impl str.Str : JSONValue
impl Numeric : JSONValue
impl bool : JSONValue
impl JSONNull : JSONValue
impl JSONDict : JSONValue
impl JSONList : JSONValue

impl JSONParser {
    static skip_whitespace_buffered(s: BufferedStream) : none {
        let ch = s.peek()
        while (ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t') {
            s.advance()
            ch = s.peek()
        }
    },
    // Internal Dispatcher (LL(1) Parser)
    static parse_internal_dispatch(stream: BufferedStream) : lang.Result<JSONValue, str.Str> {
        JSONParser.skip_whitespace_buffered(stream)
        let c = stream.peek()
        
        if (c == '{') {
            return JSONValue(JSONDict()).construct(stream)
        } elif (c == '[') {
            return JSONValue(JSONList()).construct(stream)
        } elif (c == '"') {
            // Optimized string parser
            return JSONParser.parse_string_internal(stream)
        } elif ((c >= '0' && c <= '9') || c == '-') {
            return JSONValue(Numeric()).construct(stream)
        } elif (c == 't' || c == 'f') {
            // boolean logic (simplified)
            let b_val = (c == 't')
            // Consume 'true' or 'false'
            if (b_val) { stream.seek_rel(4) } else { stream.seek_rel(5) }
            return lang.Result<JSONValue, str.Str>.ok(b_val as JSONValue)
        } elif (c == 'n') {
            stream.seek_rel(4) // consume null
            return lang.Result<JSONValue, str.Str>.ok(JSONNull() as JSONValue)
        }
        return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: Unexpected token"))
    },
    // Special optimized string parser needed to handle escaping efficiently
    static parse_string_internal(stream: BufferedStream) : lang.Result<JSONValue, str.Str> {
        stream.advance() // skip quote
        // Implementation of string parsing reading char-by-char from buffer
        // and pushing to a new Str using 'push' (which handles resizing)
        let sb = str.Str(32u)
        
        while (true) {
            let c = stream.advance()
            if (c == '\0') { return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: EOF in string")) }
            if (c == '"') { break }
            
            if (c == '\\') {
                let next = stream.advance()
                // handle escape sequences...
                if (next == 'n') { sb.push('\n') }
                elif (next == 'r') { sb.push('\r') }
                elif (next == 't') { sb.push('\t') }
                elif (next == '"') { sb.push('"') }
                elif (next == '\\') { sb.push('\\') }
                // ... etc
                else { sb.push(next) }
            } else {
                sb.push(c)
            }
        }
        return lang.Result<JSONValue, str.Str>.ok(sb as JSONValue)
    }
}

impl JSONDict : JSONValue {
    to_string() : str.Str {
        // Pre-allocate decent size to prevent early resizing
        // Heuristic: 2 chars for {}, plus assumption of data
        let sb = str.Str(64u) 
        sb.push('{')
        
        let keys_arr = this.keys()
        for (let i = 0; i < keys_arr.length; i += 1) {
            let key = keys_arr[i]
            let value = this[key]
            
            if (i > 0) {
                sb.push(',')
            }
            
            // "key":
            sb.push('"')
            sb += key  // Efficient in-place append
            sb += "\":"
            
            // value
            // Note: This still allocates a child string due to interface constraints,
            // but the append to 'sb' is linear memcpy.
            sb += value.to_string()
        }
        sb.push('}')
        return sb
    },

    construct(raw_file: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        // Cast to BufferedStream (assuming caller wraps it, see 'parse' below)
        let stream = dyn_cast<BufferedStream>(raw_file)
        
        // Skip '{'
        stream.advance() 
        
        JSONParser.skip_whitespace_buffered(stream)
        
        if (stream.peek() == '}') {
            stream.advance()
            return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
        }

        while (true) {
            JSONParser.skip_whitespace_buffered(stream)
            
            // Parse Key (Expect Quote)
            if (stream.peek() != '"') {
                return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: Expected key string"))
            }
            
            // Helper to parse string directly
            let key_res = JSONParser.parse_string_internal(stream)
            if (key_res.is_err()) { return key_res }
            let key = dyn_cast<str.Str>(key_res.unwrap())
            
            JSONParser.skip_whitespace_buffered(stream)
            
            // Expect ':'
            if (stream.advance() != ':') {
                 return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: Expected ':'"))
            }
            
            // Parse Value (Predictive)
            let val_res = JSONParser.parse_internal_dispatch(stream)
            if (val_res.is_err()) { return val_res }
            
            this[key] = val_res.unwrap()
            
            JSONParser.skip_whitespace_buffered(stream)
            
            let c = stream.peek()
            if (c == '}') {
                stream.advance()
                break
            } else {
                if (c != ',') {
                     return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: Expected ',' or '}'"))
                }
                stream.advance() // consume ','
            }
        }
        return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
    }
}

impl JSONList : JSONValue {
    to_string() : str.Str {
        let sb = str.Str(64u)
        sb.push('[')
        
        for (let i = 0; i < this.length; i += 1) {
            if (i > 0) {
                sb.push(',')
            }
            // In-place append, leveraging your Str::capacity_resize efficiency
            sb += this[i].to_string()
        }
        sb.push(']')
        return sb
    },

    construct(raw_file: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        let stream = dyn_cast<BufferedStream>(raw_file)
        stream.advance() // Skip '['
        
        JSONParser.skip_whitespace_buffered(stream)
        
        if (stream.peek() == ']') {
            stream.advance()
            return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
        }

        while (true) {
            let val_res = JSONParser.parse_internal_dispatch(stream)
            if (val_res.is_err()) { return val_res }
            
            this.push(val_res.unwrap())
            
            JSONParser.skip_whitespace_buffered(stream)
            let c = stream.peek()
            if (c == ']') {
                stream.advance()
                break
            } else {
                if (c != ',') {
                     return lang.Result<JSONValue, str.Str>.err(str.Str("JSON: Expected ','"))
                }
                stream.advance()
            }
        }
        return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
    }
}

impl Numeric : JSONValue {
    to_string() : str.Str {
        return this.data
    },
    
    construct(raw_file: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        let stream = dyn_cast<BufferedStream>(raw_file)
        
        // 1. Scan length directly in buffer without allocating
        stream.set_mark()
        let c = stream.peek()
        let is_deci = 0 // 0 = int, 1 = deci
        
        // Optional minus
        if (c == '-') { 
            stream.advance()
            c = stream.peek()
        }
        
        while ((c >= '0' && c <= '9') || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-') {
            if (c == '.') { is_deci = 1 }
            stream.advance()
            c = stream.peek()
        }
        
        let len = stream.cursor - stream.mark_pos
        
        // 2. Rewind cursor to mark
        // Safe even if buffer refilled because mark_pos would be 0 and content preserved
        stream.rewind_to_mark()
        stream.unset_mark() // Extract str will consume, so we can unset mark or just let next read overwrite
        
        // 3. Extract exact string (Single Allocation)
        let num_str = stream.extract_str(len)
        
        this.data = num_str
        this.type = is_deci as unsigned
        
        return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
    }
}

impl bool : JSONValue {
    to_string() : str.Str {
        if (this) {
            return "true"
        } else {
            return "false"
        }
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        return lang.Result<JSONValue, str.Str>.ok(this as JSONValue)
    }
}

impl JSONNull {
    constructor() {
        return this
    },
    to_string() : str.Str {
        return str.Str("null")
    }
}

impl JSONNull : JSONValue {
    to_string() : str.Str {
        return "null"
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        return lang.Result<JSONValue, str.Str>.ok(JSONNull() as JSONValue)
    }
}

impl Numeric {
    constructor(type: unsigned, data: str.Str) {
        this.type = type
        this.data = data
    },
    constructor() {
        return this
    },
    getInt() : int {
        return str.toInt(this.data)
    },
    getDecimal() : deci {
        return str.toDeci(this.data)
    },
    constructor(i: int) {
        this.type = 0u
        this.data = str.Stringable(i).to_string()
    }
}

impl str.Str : JSONValue {
    to_string() : str.Str {
        return str.format("\"{}\"", str.escape(this))
    },
    construct(raw_file: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
        return JSONParser.parse_string_internal(dyn_cast<BufferedStream>(raw_file))
    }
}

func parse(filelike: file.AbstractFile) : lang.Result<JSONValue, str.Str> {
    let stream = BufferedStream(filelike)
    return JSONParser.parse_internal_dispatch(stream)
}

func parse(s: str.Str) : lang.Result<JSONValue, str.Str> {
    let buffer = io.ArrayBuffer(s.data) as file.AbstractFile
    buffer.seek(0, 0)
    return parse(buffer)
}

impl JSONValue : str.Stringable {
    to_string() : str.Str {
        return this.to_string()
    }
}