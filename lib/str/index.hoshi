use lang "builtin"

import noffi runtime_get_string_array_data_pointer(arr: char[]) : int from "builtin"
import strlen(str: string) : unsigned from "builtin"
import memcmp(a: ptr, b: ptr, n: int) : int32 from "builtin"
import memcpy(dest: ptr, src: ptr, n: int) : ptr from "builtin"
import puts(str: string) : int32 from "builtin"

struct Str {
    data: char[],
    length: unsigned,
    capacity: unsigned,
    push(ch: char) : none,
    pop() : none,
    size() : int,
    clear() : none,
    capacity_resize(new_capacity: unsigned) : none,
    shrink_to_fit() : none,
    startswith(prefix: Str) : bool,
    endswith(suffix: Str) : bool,
    c_str() : int,
    find(pattern: Str, start: int) : int,
    always_inline find(pattern: Str) : int,
    substring(start: unsigned, end: unsigned) : Str,
    always_inline substring(start: int, end: int) : Str,
    static join(strs: Str[]) : Str,
    static join(args: ...) : Str,
    constructor(literal: string),
    constructor(arr: char[]),
    constructor(capacity: unsigned),
    constructor(),
    static operator+(a: Str, b: Str) : Str,
    static operator+(a: Str, b: string) : Str,
    static operator+(a: string, b: Str) : Str,
    static operator==(a: Str, b: Str) : bool,
    static operator==(a: Str, b: string) : bool,
    static operator==(a: string, b: Str) : bool,
    static operator!=(a: Str, b: Str) : bool,
    static operator!=(a: Str, b: string) : bool,
    static operator!=(a: string, b: Str) : bool,
    static operator[](self: Str, index: int) : char,
    static operator[](value: char, self: Str, index: int) : none
}

impl Str {
    constructor(literal: string) {
        this.length = strlen(literal)
        this.capacity = this.length + 1
        this.data = new char[this.capacity]()
        memcpy(runtime_get_string_array_data_pointer(this.data), literal, this.length)
        this.data[this.length] = '\0'
    },
    constructor(arr: char[]) {
        this.length = arr.length
        this.data = arr
        this.capacity = this.length + 1
    },
    constructor(capacity: unsigned) {
        if (capacity < 1u) {
            capacity = 1u
        }
        this.length = 0u
        this.capacity = capacity
        this.data = new char[capacity]()
        this.data[0] = '\0'
    },
    constructor() {
        this.length = 0u
        this.capacity = 1u
        this.data = new char[1]()
        this.data[0] = '\0'
    },
    capacity_resize(new_capacity: unsigned) : none {
        if (new_capacity <= this.capacity) {
            return
        }
        let new_data = new char[new_capacity]()
        memcpy(runtime_get_string_array_data_pointer(new_data), runtime_get_string_array_data_pointer(this.data), this.length)
        this.data = new_data
        this.capacity = new_capacity
    },
    push(ch: char) : none {
        if (this.length == this.capacity) {
            this.capacity_resize(this.capacity * 2)
        }
        this.data[this.length] = ch
        this.length += 1
        this.data[this.length] = '\0'
    },
    pop() : none {
        if (this.length == 0u) {
            return
        }
        this.length -= 1u
        this.data[this.length] = '\0'
    },
    size() : int {
        return this.length
    },
    clear() : none {
        this.length = 0u
        this.data[0] = '\0'
    },
    shrink_to_fit() : none {
        if (this.length == this.capacity) {
            return
        }
        let new_data = new char[this.length + 1u]()
        memcpy(runtime_get_string_array_data_pointer(new_data), runtime_get_string_array_data_pointer(this.data), this.length)
        this.data = new_data
        this.capacity = this.length + 1
    },
    startswith(prefix: Str) : bool {
        if (prefix.length > this.length) {
            return false
        }
        return memcmp(runtime_get_string_array_data_pointer(this.data), runtime_get_string_array_data_pointer(prefix.data), prefix.length) == 0
    },
    endswith(suffix: Str) : bool {
        if (suffix.length > this.length) {
            return false
        }
        return memcmp(runtime_get_string_array_data_pointer(this.data) + this.length - suffix.length, runtime_get_string_array_data_pointer(suffix.data), suffix.length) == 0
    },
    static operator+(a: Str, b: Str) : Str {
        let new_str = Str(a.length + b.length)
        memcpy(runtime_get_string_array_data_pointer(new_str.data), runtime_get_string_array_data_pointer(a.data), a.length)
        memcpy(runtime_get_string_array_data_pointer(new_str.data) + a.length, runtime_get_string_array_data_pointer(b.data), b.length)
        new_str.data[a.length + b.length] = '\0'
        new_str.length = a.length + b.length
        return new_str
    },
    static operator+(a: Str, b: string) : Str {
        let new_str = Str(a.length + strlen(b))
        memcpy(runtime_get_string_array_data_pointer(new_str.data), runtime_get_string_array_data_pointer(a.data), a.length)
        memcpy(runtime_get_string_array_data_pointer(new_str.data) + a.length, b, strlen(b))
        new_str.data[a.length + strlen(b)] = '\0'
        new_str.length = a.length + strlen(b)
        return new_str
    },
    static operator+(a: string, b: Str) : Str {
        let new_str = Str(strlen(a) + b.length)
        memcpy(runtime_get_string_array_data_pointer(new_str.data), a, strlen(a))
        memcpy(runtime_get_string_array_data_pointer(new_str.data) + strlen(a), runtime_get_string_array_data_pointer(b.data), b.length)
        new_str.data[strlen(a) + b.length] = '\0'
        new_str.length = strlen(a) + b.length
        return new_str
    },
    static operator==(a: Str, b: Str) : bool {
        if (a.length != b.length) {
            return false
        }
        return memcmp(runtime_get_string_array_data_pointer(a.data), runtime_get_string_array_data_pointer(b.data), a.length) == 0
    },
    static operator==(a: Str, b: string) : bool {
        if (a.length != strlen(b)) {
            return false
        }
        return memcmp(runtime_get_string_array_data_pointer(a.data), b, a.length) == 0
    },
    static operator==(a: string, b: Str) : bool {
        if (strlen(a) != b.length) {
            return false
        }
        return memcmp(a, runtime_get_string_array_data_pointer(b.data), b.length) == 0
    },
    static operator!=(a: Str, b: Str) : bool {
        if (a.length != b.length) {
            return true
        }
        return memcmp(runtime_get_string_array_data_pointer(a.data), runtime_get_string_array_data_pointer(b.data), a.length) != 0
    },
    static operator!=(a: Str, b: string) : bool {
        if (a.length != strlen(b)) {
            return true
        }
        return memcmp(runtime_get_string_array_data_pointer(a.data), b, a.length) != 0
    },
    static operator!=(a: string, b: Str) : bool {
        if (strlen(a) != b.length) {
            return true
        }
        return memcmp(a, runtime_get_string_array_data_pointer(b.data), b.length) != 0
    },
    static operator[](self: Str, index: int) : char {
        if (index < 0 || index >= self.length) {
            return '\0'
        }
        return self.data[index]
    },
    static operator[](value: char, self: Str, index: int) : none {
        if (index < 0 || index >= self.length) {
            return
        }
        self.data[index] = value
    },
    c_str() : int {
        return runtime_get_string_array_data_pointer(this.data)
    },
    find(pattern: Str, start: int) : int {
        if (pattern.length > this.length) {
            return -1
        }
        // a simple implementation of Knuth-Morris-Pratt algorithm
        // build next array
        let next = new int[pattern.length](0)
        let prefix_length = 0
        let i = 1
        while (i < pattern.length) {
            if (pattern[i] == pattern[prefix_length]) {
                prefix_length += 1
                next[i] = prefix_length
                i += 1
            } else {
                if (prefix_length == 0) {
                    next[i] = 0
                    i += 1
                } else {
                    prefix_length = next[prefix_length - 1]
                }
            }
        }
        // search
        i = 0
        let j = 0
        while (i < this.length) {
            if (this[i] == pattern[j]) {
                i += 1
                j += 1
            } elif (j > 0) {
                j = next[j - 1]
            } else {
                i += 1
            }
            if (j == pattern.length) {
                return i - j
            }
        }
        return -1
    },
    always_inline find(pattern: Str) : int {
        return this.find(pattern, 0)
    },
    substring(start: unsigned, end: unsigned) : Str {
        let new_str = Str(end - start)
        memcpy(runtime_get_string_array_data_pointer(new_str.data), runtime_get_string_array_data_pointer(this.data) + start, end - start)
        new_str.data[end - start] = '\0'
        new_str.length = end - start
        return new_str
    },
    always_inline substring(start: int, end: int) : Str {
        return this.substring(start as unsigned, end as unsigned)
    },
    join(strs: Str[]) : Str {
        let total_length = 0u
        for (let i = 0; i < strs.length; i += 1) {
            total_length += strs[i].length
        }
        let new_str = Str(total_length)
        let offset = 0
        for (let i = 0; i < strs.length; i += 1) {
            memcpy(runtime_get_string_array_data_pointer(new_str.data) + offset, runtime_get_string_array_data_pointer(strs[i].data), strs[i].length)
            offset += strs[i].length
        }
        new_str.data[total_length] = '\0'
        new_str.length = total_length
        return new_str
    },
    join(args: ...) : Str {
        let strs = new Str[args.length]()
        for (let i = 0; i < args.length; i += 1) {
            if (args[i] interfaceof Str) {
                strs[i] = dyn_cast<Str>(args[i])
            } elif (args[i] interfaceof string) {
                strs[i] = Str(dyn_cast<string>(args[i]))
            }
        }
        return Str.join(strs)
    }
}

impl Str : lang.Hashable {
    hash() : int {
        let res = 0
        for (let i = 0; i < this.length; i += 1) {
            res = (res * 31 + this[i]) & 0xffffffff
        }
        return res
    }
}