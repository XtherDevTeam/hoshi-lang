use file "file"
use str "str"
use runtime "runtime"
use lang "builtin"

struct OSFile {
    fp: unsigned,
    isText: bool,
    path: str.Str,
    constructor(fp: unsigned, isText: bool, path: str.Str)
}

impl OSFile {
    constructor(fp: unsigned, isText: bool, path: str.Str) {
        this.fp = fp
        this.isText = isText
        this.path = path
    }
}

impl OSFile : file.AbstractFile {
    read(size: int): file.ReadBufferView {
        let buffer = new char[size]()
        let bytes_read = runtime.fread(runtime.runtime_get_string_array_data_pointer(buffer), 1, size, this.fp)
        return file.ReadBufferView(bytes_read, buffer)
    },
    write(data: char[]) : int {
        runtime.fwrite(runtime.runtime_get_string_array_data_pointer(data), 1, data.length - this.isText, this.fp)
        return data.length
    },
    close() : none {
        runtime.fclose(this.fp)
    },
    seek(offset: int, whence: int) : int {
        return runtime.fseek(this.fp, offset, whence)
    },
    tell() : int {
        return runtime.ftell(this.fp)
    },
    flush() : none {
        runtime.fflush(this.fp)
    },
    is_eof() : bool {
        return runtime.feof(this.fp)
    },
    size() : int {
        // seek to the end of the file
        let current_pos = runtime.ftell(this.fp)
        runtime.fseek(this.fp, 0, 2)
        let size = runtime.ftell(this.fp)
        runtime.fseek(this.fp, current_pos, 0)
        return size
    },
    is_seekable() : bool {
        return true
    },
    is_readable() : bool {
        return true
    },
    is_writable() : bool {
        return true
    },
    is_closed() : bool {
        return runtime.fclose(this.fp) == 0
    },
    getch() : char {
        return runtime.fgetc(this.fp)
    }
}

func open(path: str.Str, mode: str.Str) : lang.Result<OSFile, str.Str> {
    let fp = runtime.fopen(path.c_str(), mode.c_str())
    if (fp == 0) {
        return lang.Result<OSFile, str.Str>.err(str.Str("failed to open file"))
    }
    let isText = mode.find('b') == -1
    return lang.Result<OSFile, str.Str>.ok(OSFile(fp, isText, path))
}

func stdin() : OSFile {
    return OSFile(runtime.runtime_get_stdin_fp(), true, str.Str("stdin"))
}

func stdout() : OSFile {
    return OSFile(runtime.runtime_get_stdout_fp(), true, str.Str("stdout"))
}

func stderr() : OSFile {
    return OSFile(runtime.runtime_get_stderr_fp(), true, str.Str("stderr"))
}