use file "file"
use str "str"
use runtime "runtime"
use lang "builtin"
use vec "vec"

enum PathSplitPreference {
    Backslash,  // /
    Rightslash  // \
}

[[platform == "darwin"]] let path_sep_preference = PathSplitPreference.Backslash
[[platform == "linux"]] let path_sep_preference = PathSplitPreference.Backslash
[[platform == "win32"]] let path_sep_preference = PathSplitPreference.Rightslash


struct Path {
    parts: vec.Vec<str.Str>,
    constructor(parts: vec.Vec<str.Str>),
    constructor(s: str.Str),
    static operator/(left: Path, right: str.Str) : Path,
    static operator/(left: Path, right: Path) : Path,
    is_file() : bool,
    is_directory() : bool,
    exists() : bool,
    parent() : Path,
    static current_dir() : Path,
    static home_dir() : Path,
    static temp_dir() : Path,
    to_string() : str.Str,
    mkdir() : bool,
    mkdir(recursive: bool) : bool,
    realpath() : Path,
    remove(recursive: bool) : bool,
    remove() : bool,
    rename(new_name: str.Str) : bool,
    move(new_path: Path) : bool,
    listdir() : vec.Vec<Path>,
    stem() : str.Str,
    extension() : str.Str,
    filename() : str.Str
}

impl Path {
    constructor(parts: vec.Vec<str.Str>) {
        this.parts = parts
    },
    constructor(s: str.Str) {
        if (s.length != 0 && s[s.length - 1] == '/' || s[s.length - 1] == '\\') {
            s.pop()
        }
        let sep : str.Str = ""
        if (path_sep_preference == PathSplitPreference.Backslash) {
            sep = "/"
        } else {
            sep = "\\"
        }
        this.parts = vec.Vec<str.Str>(s.split(sep))
    },
    static operator/(left: Path, right: str.Str) : Path {
        let right_path = Path(right)
        let parts = left.parts.clone()
        for (let index = 0;index < right_path.parts.length; index += 1) {
            parts.push(right_path.parts[index])
        }
        return Path(parts)
    },
    static operator/(left: Path, right: Path) : Path {
        let parts = left.parts.clone()
        for (let index = 0;index < right.parts.length; index += 1) {
            parts.push(right.parts[index])
        }
        return Path(parts)
    },
    is_file() : bool {
        let file_path = this.to_string()
        return runtime.runtime_fs_isfile(file_path.c_str()) 
    },
    is_directory() : bool {
        let dir_path = this.to_string()
        return runtime.runtime_fs_isdir(dir_path.c_str())
    },
    exists() : bool {
        let file_path = this.to_string()
        return runtime.runtime_fs_exists(file_path.c_str())
    },
    parent() : Path {
        if (this.parts.length <= 1) {
            return this
        }
        let parts = this.parts.clone()
        parts.pop()
        return Path(parts)
    },
    static current_dir() : Path {
        let p = runtime.runtime_fs_cwd()
        let current_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(current_dir)
    },
    static home_dir() : Path {
        let p = runtime.runtime_fs_home_dir()
        let home_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(home_dir)
    },
    static temp_dir() : Path {
        let p = runtime.runtime_fs_temp_dir()
        let temp_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(temp_dir)
    },
    to_string() : str.Str {
        let sep : str.Str = ""
        if (path_sep_preference == PathSplitPreference.Backslash) {
            sep = "/"
        } else {
            sep = "\\"
        }
        let built : str.Str = ""
        for (let index = 0;index < this.parts.length; index += 1) {
            built += this.parts[index]
            if (index != this.parts.length - 1) {
                built += sep
            }
        }
        return built
    },
    mkdir() : bool {
        return this.mkdir(false)
    },
    mkdir(recursive: bool) : bool {
        if (recursive) {
            let p = this.parent()
            if (p.exists() == false) {
                this.parent().mkdir(true)
            }
        }
        let s = this.to_string()
        return runtime.runtime_fs_mkdir(s.c_str(), 0755)
    },
    realpath() : Path {
        let s = this.to_string()
        let p = runtime.runtime_fs_realpath(s.c_str())
        if (p == 0) {
            return null
        }
        let real_path = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(real_path)
    },
    remove(recursive: bool) : bool {
        let s = this.to_string()
        if (this.is_file()) {
            return runtime.runtime_fs_remove(s.c_str())
        } elif (this.is_directory()) {
            let entries = this.listdir()
            for (let index = 0;index < entries.length; index += 1) {
                entries[index].remove(recursive)
            }
            return runtime.runtime_fs_rmdir(s.c_str())
        }
        return false
    },
    remove() : bool {
        return this.remove(false)
    },
    rename(new_name: str.Str) : bool {
        let old_path = this.to_string()
        let new_path = this.parent() / new_name
        let new_path_str = new_path.to_string()
        return runtime.runtime_fs_rename(old_path.c_str(), new_path_str.c_str())
    },
    move(new_path: Path) : bool {
        let old_path = this.to_string()
        let new_path_str = new_path.to_string()
        return runtime.runtime_fs_rename(old_path.c_str(), new_path_str.c_str())
    },
    listdir() : vec.Vec<Path> {
        let dir_path = this.to_string()
        let dir = runtime.runtime_fs_opendir(dir_path.c_str())
        if (dir == 0) {
            return vec.Vec<Path>()
        }
        let entries = vec.Vec<Path>()
        let entry = runtime.runtime_fs_readdir(dir)
        while (entry != 0) {
            let name = str.Str.from_c_str(entry)
            if (name != "." && name != "..") {
                entries.push(this / name)
            }
            entry = runtime.runtime_fs_readdir(dir)
        }
        runtime.runtime_fs_closedir(dir)
        return entries
    },
    stem() : str.Str {
        let filename = this.filename()
        let index = filename.rfind('.')
        if (index == -1 || index == 0) {
            return filename
        }
        return filename.substring(0, index)
    },
    extension() : str.Str {
        let filename = this.filename()
        let index = filename.rfind('.')
        if (index == -1 || index == 0) {
            return ""
        }
        return filename.substring(index, filename.length)
    },
    filename() : str.Str {
        if (this.parts.length == 0) {
            return ""
        }
        return this.parts[this.parts.length - 1]
    }
}

impl Path : str.Stringable {
    to_string() : str.Str {
        return this.to_string()
    }
}

struct OSFile {
    fp: unsigned,
    isText: bool,
    noFinalizer: bool,
    path: str.Str,
    constructor(fp: unsigned, isText: bool, path: str.Str),
    constructor(fp: unsigned, isText: bool, path: str.Str, noFinalizer: bool),
    read(size: int) : file.ReadBufferView,
    write(data: char[]) : int,
    write(data: char[], size: int) : int,
    close() : none,
    seek(offset: int, whence: int) : int,
    tell() : int,
    flush() : none,
    is_eof() : bool,
    size() : int,
    is_seekable() : bool,
    is_readable() : bool,
    is_writable() : bool,
    is_closed() : bool,
    getch() : char,
    putch(c: char) : none,
    finalizer()
}

impl OSFile {
    constructor(fp: unsigned, isText: bool, path: str.Str) {
        this.fp = fp
        this.isText = isText
        this.path = path
        this.noFinalizer = false
    },
    constructor(fp: unsigned, isText: bool, path: str.Str, noFinalizer: bool) {
        this.fp = fp
        this.isText = isText
        this.path = path
        this.noFinalizer = noFinalizer
    },
    read(size: int): file.ReadBufferView {
        let buffer = new char[size]()
        let bytes_read = runtime.fread(runtime.runtime_get_string_array_data_pointer(buffer), 1, size, this.fp)
        return file.ReadBufferView(bytes_read, buffer)
    },
    write(data: char[]) : int {
        return runtime.fwrite(runtime.runtime_get_string_array_data_pointer(data), 1, data.length - this.isText, this.fp)
    },
    write(data: char[], size: int) : int {
        return runtime.fwrite(runtime.runtime_get_string_array_data_pointer(data), 1, size, this.fp)
    },
    close() : none {
        runtime.fclose(this.fp)
        this.fp = 0
    },
    seek(offset: int, whence: int) : int {
        return runtime.fseek(this.fp, offset, whence)
    },
    tell() : int {
        return runtime.ftell(this.fp)
    },
    flush() : none {
        runtime.fflush(this.fp)
    },
    is_eof() : bool {
        return runtime.feof(this.fp)
    },
    size() : int {
        // seek to the end of the file
        let current_pos = runtime.ftell(this.fp)
        runtime.fseek(this.fp, 0, 2)
        let size = runtime.ftell(this.fp)
        runtime.fseek(this.fp, current_pos, 0)
        return size
    },
    is_seekable() : bool {
        return true
    },
    is_readable() : bool {
        return true
    },
    is_writable() : bool {
        return true
    },
    is_closed() : bool {
        return this.fp == 0
    },
    getch() : char {
        return runtime.fgetc(this.fp)
    },
    putch(c: char) : none {
        runtime.fputc(c, this.fp)
    },
    finalizer() {
        if (this.fp != 0 && this.noFinalizer == false) {
            this.close()
        }
    }
}

impl OSFile : file.AbstractFile {
    read(size: int) : file.ReadBufferView {
        return this.read(size)
    },
    write(data: char[]) : int {
        return this.write(data)
    },
    write(data: char[], size: int) : int {
        return this.write(data, size)
    },
    close() : none {
        this.close()
    },
    seek(offset: int, whence: int) : int {
        return this.seek(offset, whence)
    },
    tell() : int {
        return this.tell()
    },
    flush() : none {
        this.flush()
    },
    is_eof() : bool {
        return this.is_eof()
    },
    size() : int {
        return this.size()
    },
    is_seekable() : bool {
        return this.is_seekable()
    },
    is_readable() : bool {
        return this.is_readable()
    },
    is_writable() : bool {
        return this.is_writable()
    },
    is_closed() : bool {
        return this.is_closed()
    },
    getch() : char {
        return this.getch()
    },
    putch(c: char) : none {
        this.putch(c)
        return
    }
}

func open(path: str.Str, mode: str.Str) : lang.Result<OSFile, str.Str> {
    let fp = runtime.fopen(path.c_str(), mode.c_str())
    if (fp == 0) {
        return lang.Result<OSFile, str.Str>.err(str.Str("failed to open file"))
    }
    let isText = mode.find('b') == -1
    return lang.Result<OSFile, str.Str>.ok(OSFile(fp, isText, path))
}

func stdin() : OSFile {
    return OSFile(runtime.runtime_get_stdin_fp(), true, str.Str("stdin"), true)
}

func stdout() : OSFile {
    return OSFile(runtime.runtime_get_stdout_fp(), true, str.Str("stdout"), true)
}

func stderr() : OSFile {
    return OSFile(runtime.runtime_get_stderr_fp(), true, str.Str("stderr"), true)
}