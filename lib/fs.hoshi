use file "file"
use str "str"
use runtime "runtime"
use lang "builtin"
use vec "vec"

enum PathSplitPreference {
    Backslash,  // /
    Rightslash  // \
}

[[platform == "darwin"]] let path_sep_preference = PathSplitPreference.Backslash
[[platform == "linux"]] let path_sep_preference = PathSplitPreference.Backslash
[[platform == "win32"]] let path_sep_preference = PathSplitPreference.Rightslash


struct Path {
    parts: vec.Vec<str.Str>,
    constructor(parts: vec.Vec<str.Str>),
    constructor(s: str.Str),
    static operator/(left: Path, right: str.Str) : Path,
    static operator/(left: Path, right: Path) : Path,
    is_file() : bool,
    is_directory() : bool,
    exists() : bool,
    parent() : Path,
    static current_dir() : Path,
    static home_dir() : Path,
    static temp_dir() : Path,
    to_string() : str.Str
}

impl Path {
    constructor(parts: vec.Vec<str.Str>) {
        this.parts = parts
    },
    constructor(s: str.Str) {
        let sep : str.Str = ""
        if (path_sep_preference == PathSplitPreference.Backslash) {
            sep = "/"
        } else {
            sep = "\\"
        }
        this.parts = vec.Vec<str.Str>(s.split(sep))
    },
    static operator/(left: Path, right: str.Str) : Path {
        let right_path = Path(right)
        let parts = left.parts
        for (let index = 0;index < right_path.parts.length; index += 1) {
            parts.push(right_path.parts[index])
        }
        return Path(parts)
    },
    static operator/(left: Path, right: Path) : Path {
        let parts = left.parts
        for (let index = 0;index < right.parts.length; index += 1) {
            parts.push(right.parts[index])
        }
        return Path(parts)
    },
    is_file() : bool {
        let file_path = this.to_string()
        return runtime.runtime_fs_isfile(file_path.c_str()) 
    },
    is_directory() : bool {
        let dir_path = this.to_string()
        return runtime.runtime_fs_isdir(dir_path.c_str())
    },
    exists() : bool {
        let file_path = this.to_string()
        return runtime.runtime_fs_exists(file_path.c_str())
    },
    parent() : Path {
        let parts = this.parts
        parts.pop()
        return Path(parts)
    },
    static current_dir() : Path {
        let p = runtime.runtime_fs_cwd()
        let current_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(current_dir)
    },
    static home_dir() : Path {
        let p = runtime.runtime_fs_home_dir()
        let home_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(home_dir)
    },
    static temp_dir() : Path {
        let p = runtime.runtime_fs_temp_dir()
        let temp_dir = str.Str.from_c_str(p)
        runtime.runtime_fs_finalize(p)
        return Path(temp_dir)
    },
    to_string() : str.Str {
        let sep : str.Str = ""
        if (path_sep_preference == PathSplitPreference.Backslash) {
            sep = "/"
        } else {
            sep = "\\"
        }
        return str.join(sep, this.parts.data)
    }
}

impl Path : str.Stringable {
    to_string() : str.Str {
        return this.to_string()
    }
}

struct OSFile {
    fp: unsigned,
    isText: bool,
    path: str.Str,
    constructor(fp: unsigned, isText: bool, path: str.Str)
}

impl OSFile {
    constructor(fp: unsigned, isText: bool, path: str.Str) {
        this.fp = fp
        this.isText = isText
        this.path = path
    }
}

impl OSFile : file.AbstractFile {
    read(size: int): file.ReadBufferView {
        let buffer = new char[size]()
        let bytes_read = runtime.fread(runtime.runtime_get_string_array_data_pointer(buffer), 1, size, this.fp)
        return file.ReadBufferView(bytes_read, buffer)
    },
    write(data: char[]) : int {
        runtime.fwrite(runtime.runtime_get_string_array_data_pointer(data), 1, data.length - this.isText, this.fp)
        return data.length
    },
    close() : none {
        runtime.fclose(this.fp)
    },
    seek(offset: int, whence: int) : int {
        return runtime.fseek(this.fp, offset, whence)
    },
    tell() : int {
        return runtime.ftell(this.fp)
    },
    flush() : none {
        runtime.fflush(this.fp)
    },
    is_eof() : bool {
        return runtime.feof(this.fp)
    },
    size() : int {
        // seek to the end of the file
        let current_pos = runtime.ftell(this.fp)
        runtime.fseek(this.fp, 0, 2)
        let size = runtime.ftell(this.fp)
        runtime.fseek(this.fp, current_pos, 0)
        return size
    },
    is_seekable() : bool {
        return true
    },
    is_readable() : bool {
        return true
    },
    is_writable() : bool {
        return true
    },
    is_closed() : bool {
        return runtime.fclose(this.fp) == 0
    },
    getch() : char {
        return runtime.fgetc(this.fp)
    }
}

func open(path: str.Str, mode: str.Str) : lang.Result<OSFile, str.Str> {
    let fp = runtime.fopen(path.c_str(), mode.c_str())
    if (fp == 0) {
        return lang.Result<OSFile, str.Str>.err(str.Str("failed to open file"))
    }
    let isText = mode.find('b') == -1
    return lang.Result<OSFile, str.Str>.ok(OSFile(fp, isText, path))
}

func stdin() : OSFile {
    return OSFile(runtime.runtime_get_stdin_fp(), true, str.Str("stdin"))
}

func stdout() : OSFile {
    return OSFile(runtime.runtime_get_stdout_fp(), true, str.Str("stdout"))
}

func stderr() : OSFile {
    return OSFile(runtime.runtime_get_stderr_fp(), true, str.Str("stderr"))
}