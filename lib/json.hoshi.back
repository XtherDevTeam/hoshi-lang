use str "str"
use hashMap "hashMap"
use file "file"
use lang "builtin"
use io "io"
use runtime "runtime"
use vec "vec"

enum ResultCode {
    Success,
    // Boolean errors
    ExpectedTrue,
    ExpectedFalse,
    InvalidBooleanStart,
    
    // Generic/Parser errors
    UnexpectedToken,
    UnexpectedEOF,
    
    // String errors
    ExpectedQuote,
    
    // Numeric errors
    InvalidNumberFormat,
    ExpectedDigit,
    
    // Null errors
    ExpectedNullStart,
    ExpectedNullBody,
    
    // Object (Dict) errors
    ExpectedObjectStart,
    ExpectedColon,
    ExpectedObjectCommaOrEnd,
    
    // Array (List) errors
    ExpectedArrayStart,
    ExpectedArrayCommaOrEnd
}

func always_inline skip_whitespace(s: file.AbstractFile) : none {
    let pos = s.tell()
    let ch = s.getch()
    while (ch != '\0' && (ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t')) {
        pos = s.tell()
        ch = s.getch()
    }
    if (ch != '\0') {
        s.seek(pos, 0)
    }
}

interface JSONValue {
    to_string(): str.Str,
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode>
}

interface JSONSerializable {
    to_json() : JSONValue
}

alias JSONDict = hashMap.HashMap<str.Str, JSONValue>

alias JSONList = vec.Vec<JSONValue>

struct JSONNull {
    to_string() : str.Str,
    constructor()
}

struct Numeric {
    type: unsigned, /* 0 = int, 1 = decimal */
    data: str.Str,
    getInt() : int,
    getDecimal() : deci,
    constructor(type: unsigned, data: str.Str),
    constructor(),
    constructor(i: int)
}

/* forward-declaration */

impl str.Str : JSONValue
impl Numeric : JSONValue
impl bool : JSONValue
impl JSONNull : JSONValue
impl JSONDict : JSONValue
impl JSONList : JSONValue

impl bool : JSONValue {
    to_string() : str.Str {
        if (this) {
            return "true"
        } else {
            return "false"
        }
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        let start_pos = stream.tell()
        let ch = stream.getch()
        if (ch == 't') {
            let next3Char = stream.read(3)
            if (next3Char.data[0] != 'r' || next3Char.data[1] != 'u' || next3Char.data[2] != 'e') {
                stream.seek(start_pos, 0)
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedTrue)
            }
            return lang.Result<JSONValue, ResultCode>.ok(true as JSONValue)
        } elif (ch == 'f') {
            let next4Char = stream.read(4)
            if (next4Char.data[0] != 'a' || next4Char.data[1] != 'l' || next4Char.data[2] != 's' || next4Char.data[3] != 'e') {
                stream.seek(start_pos, 0)
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedFalse)
            }
            return lang.Result<JSONValue, ResultCode>.ok(false as JSONValue)
        } else {
            stream.seek(start_pos, 0)
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.InvalidBooleanStart)
        }
    }
}

impl JSONNull {
    constructor() {
        return this
    },
    to_string() : str.Str {
        return str.Str("null")
    }
}

impl Numeric {
    constructor(type: unsigned, data: str.Str) {
        this.type = type
        this.data = data
    },
    constructor() {
        return this
    },
    getInt() : int {
        return str.toInt(this.data)
    },
    getDecimal() : deci {
        return str.toDeci(this.data)
    },
    constructor(i: int) {
        this.type = 0
        this.data = str.Stringable(i).to_string()
    }
}

func parse(filelike: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
    // evaluate the start of type to determine the type of JSON constructor to be used
    skip_whitespace(filelike)
    let pos = filelike.tell()
    let ch = filelike.getch()
    if (ch == '{') {
        filelike.seek(pos, 0)
        return JSONValue(JSONDict()).construct(filelike)
    } elif (ch == '"') {
        filelike.seek(pos, 0)
        return JSONValue(str.Str()).construct(filelike)
    } elif ((ch >= '0' && ch <= '9') || ch == '-') {
        filelike.seek(pos, 0)
        return JSONValue(Numeric()).construct(filelike)
    } elif (ch == '[') {
        filelike.seek(pos, 0)
        return JSONValue(JSONList()).construct(filelike)
    } elif (ch == 'n') {
        // null
        filelike.seek(pos, 0)
        return JSONValue(JSONNull()).construct(filelike)
    } elif (ch == 't' || ch == 'f') {
        filelike.seek(pos, 0)
        return JSONValue(false).construct(filelike)
    } else {
        // future support for arrays, booleans, null would go here
        return lang.Result<JSONValue, ResultCode>.err(ResultCode.UnexpectedToken)
    }
}

/* actual implementation */

impl str.Str : JSONValue {
    to_string() : str.Str {
        return str.format("\"{}\"", str.escape(this))
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        let start_pos = stream.tell()
        if (stream.getch() == '"') {
            let content_pos = stream.tell()
            let ch = stream.getch()
            while (ch != '\0' && ch != '"') {
                if (ch == '\\') {
                    ch = stream.getch() // consume escaped character
                }
                ch = stream.getch()
            }
            if (ch == '"') {
                let end_pos = stream.tell()
                stream.seek(content_pos, 0)
                let buffer = stream.read(end_pos - content_pos - 1)
                // TODO: handle un-escaping characters from buffer
                this.data = buffer.data
                this.length = buffer.size
                this.capacity = buffer.size
                // read ahead to skip \"
                stream.getch()
                return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
            } else {
                stream.seek(start_pos, 0)
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.UnexpectedEOF)
            }
        } else {
            stream.seek(start_pos, 0)
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedQuote)
        }
    }
}

impl Numeric : JSONValue {
    to_string() : str.Str {
        return this.data
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        let start_pos = stream.tell()
        let ch = stream.getch()
        let type = 0 // default to int
        
        // optional leading minus sign
        if (ch == '-') {
            ch = stream.getch()
        }

        if (ch < '0' || ch > '9') {
             stream.seek(start_pos, 0)
             return lang.Result<JSONValue, ResultCode>.err(ResultCode.InvalidNumberFormat)
        }
        
        while (ch >= '0' && ch <= '9') {
            ch = stream.getch()
        }

        if (ch == '.') {
            type = 1 // decimal
            ch = stream.getch()
            if (ch < '0' || ch > '9') {
                stream.seek(start_pos, 0)
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedDigit)
            }
            while (ch >= '0' && ch <= '9') {
                ch = stream.getch()
            }
        }
        
        // TODO: Add support for scientific notation 'e' or 'E'

        let end_pos = stream.tell()
        // the loop reads one character past the end of the number, so go back one.
        stream.seek(end_pos - 1, 0) 
        
        let read_len = stream.tell() - start_pos
        stream.seek(start_pos, 0)
        let buffer = stream.read(read_len)
        
        this.data = str.Str(buffer.data)
        this.type = type
        return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
    }
}

impl JSONNull : JSONValue {
    to_string() : str.Str {
        return "null"
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        if (stream.getch() != 'n') {
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedNullStart)
        }
        let next3Char = stream.read(3)
        // if (str.Str() != "ull") {
        if (next3Char.data[0] != 'u' || next3Char.data[1] != 'l' || next3Char.data[2] != 'l') {
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedNullBody)
        }
        // unget one ch
        return lang.Result<JSONValue, ResultCode>.ok(JSONNull() as JSONValue)
    }
}

impl JSONDict : JSONValue {
    to_string() : str.Str {
        let s = str.Str("{")
        let keys_arr = this.keys()
        for (let i = 0; i < keys_arr.length; i += 1) {
            let key = keys_arr[i]
            let value = this[key]
            // s += key
            // s += ":"
            // s.append(value.to_string())
            s = s + str.format("\"{}\":{}", key, value.to_string())
            if (i < keys_arr.length - 1) {
                s = s + ","
            }
        }
        s = s + "}"
        return s
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        skip_whitespace(stream)
        
        if (stream.getch() != '{') {
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedObjectStart)
        }
        
        this.clear()
        
        skip_whitespace(stream)
        
        // handle empty object {}
        let pos = stream.tell()
        if (stream.getch() == '}') {
            return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
        }
        stream.seek(pos, 0)
        
        // loop for key-value pairs
        while (true) {
            skip_whitespace(stream)
            
            let key = str.Str()
            let key_result = JSONValue(key).construct(stream)
            if (key_result.is_err()) {
                return lang.Result<JSONValue, ResultCode>.err(key_result.unwrap_err())
            }
            
            skip_whitespace(stream)
            
            // 2. Parse colon
            if (stream.getch() != ':') {
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedColon)
            }
            
            skip_whitespace(stream)
            
            // parse value by peeking at the next character
            
            let resultValue = parse(stream)
            if (resultValue.is_err()) {
                return resultValue
            }
            this[key] = resultValue.unwrap()
            
            skip_whitespace(stream)
            
            // parse separator (comma or closing brace)
            let separator = stream.getch()
            if (separator == '}') {
                break // End of object
            }
            if (separator != ',') {
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedObjectCommaOrEnd)
            }
        }
        
        return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
    }
}

impl JSONList : JSONValue {
    to_string() : str.Str {
        let s = str.Str("[")
        for (let i = 0; i < this.length; i += 1) {
            let value = this[i]
            s += value.to_string()
            if (i < this.length - 1) {
                s = s + ","
            }
        }
        s = s + "]"
        return s
    },
    construct(stream: file.AbstractFile) : lang.Result<JSONValue, ResultCode> {
        skip_whitespace(stream)
        if (stream.getch() != '[') {
            return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedArrayStart)
        }
        this.clear()
        skip_whitespace(stream)
        // handle empty array []
        let pos = stream.tell()
        if (stream.getch() == ']') {
            return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
        }
        stream.seek(pos, 0)
        // loop for values
        while (true) {
            skip_whitespace(stream)
            let value_pos = stream.tell()
            let peek_ch = stream.getch()
            stream.seek(value_pos, 0)
            let resultValue = parse(stream)
            if (resultValue.is_err()) {
                return resultValue
            }
            
            this.push(resultValue.unwrap())
            skip_whitespace(stream)
            let separator = stream.getch()
            if (separator == ']') {
                break // End of array
            }
            if (separator != ',') {
                return lang.Result<JSONValue, ResultCode>.err(ResultCode.ExpectedArrayCommaOrEnd)
            }
        }
        return lang.Result<JSONValue, ResultCode>.ok(this as JSONValue)
    }
}

func parse(s: str.Str) : lang.Result<JSONValue, ResultCode> {
    let buffer = io.ArrayBuffer(s.data) as file.AbstractFile
    buffer.seek(0, 0)
    return parse(buffer)
}

impl JSONValue : str.Stringable {
    to_string() : str.Str {
        return this.to_string()
    }
}