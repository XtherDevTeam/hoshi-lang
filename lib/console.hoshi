use file "file"
use fs "fs"
use str "str"
use runtime "runtime"

let stdout = fs.stdout() as file.AbstractFile
let stdin = fs.stdin() as file.AbstractFile

func print(s: str.Str) : none {
    stdout.write(s.data)
    stdout.flush()
}

func print(args: ...str.Stringable) : none {
    let strings = new str.Str[args.length]()
    for (let i = 0; i < args.length; i += 1) {
        strings[i] = args[i].to_string()
    }
    let s = str.join(" ", strings)
    stdout.write(s.data)
    stdout.flush()
}

func input() : str.Str {
    let buffer = str.Str("")
    let ch : char = 0
    while (ch == '\r' || ch == '\n') {
        ch = stdin.getch()
    }
    while (ch != '\n' && ch != '\r') {
        buffer.push(ch)
        ch = stdin.getch()
    }
    return buffer
}

func input(s: str.Str) : str.Str {
    print(s)
    return input()
}