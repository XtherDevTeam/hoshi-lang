R"(struct TypeInfo {
    id: int,
    name: string,
    type_enum: int,
    module: int,
    index: int,
    is_array: int,
    constructor(id: int, name: string, type_enum: int, module: int, index: int, is_array: int),
    constructor(id: int)
}

import noffi rtti_object_alloc(id: int) : TypeInfo from "builtin"

import noffi runtime_get_argv() : string[] from "builtin"

impl TypeInfo {
    constructor(id: int, name: string, type_enum: int, module: int, index: int, is_array: int) {
        this.id = id
        this.name = name
        this.type_enum = type_enum
        this.module = module
        this.index = index
        this.is_array = is_array
    },
    constructor(id: int) {
        this := rtti_object_alloc(id)
    }
}

func argv() : string[] {
    return runtime_get_argv()
}

interface Hashable {
    hash() : int
}

impl int : Hashable {
    hash() : int {
        return this
    }
}

impl bool : Hashable {
    hash() : int {
        if (this) {
            return 1
        } else {
            return 0
        }
    }
}

impl deci : Hashable {
    hash() : int {
        return this
    }
}

impl char : Hashable {
    hash() : int {
        return this
    }
})"