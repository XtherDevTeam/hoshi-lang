R"(struct TypeInfo {
    id: int,
    name: string,
    type_enum: int,
    module: int,
    index: int,
    is_array: int,
    constructor(id: int, name: string, type_enum: int, module: int, index: int, is_array: int),
    constructor(id: int)
}

import noffi rtti_object_alloc(id: int) : TypeInfo from "builtin"

import noffi runtime_get_argv() : string[] from "builtin"

import runtime_panic(reason: ptr) : none from "builtin"

impl TypeInfo {
    constructor(id: int, name: string, type_enum: int, module: int, index: int, is_array: int) {
        this.id = id
        this.name = name
        this.type_enum = type_enum
        this.module = module
        this.index = index
        this.is_array = is_array
    },
    constructor(id: int) {
        this := rtti_object_alloc(id)
    }
}

func argv() : string[] {
    return runtime_get_argv()
}

interface Hashable {
    hash() : int
}

impl int : Hashable {
    hash() : int {
        return this
    }
}

impl bool : Hashable {
    hash() : int {
        if (this) {
            return 1
        } else {
            return 0
        }
    }
}

impl deci : Hashable {
    hash() : int {
        return this
    }
}

impl char : Hashable {
    hash() : int {
        return this
    }
}

struct Result<T, E> {
    value: T,
    error: E,
    constructor(error: E),
    constructor(value: T),
    is_ok() : bool,
    is_err() : bool,
    unwrap() : T,
    unwrap_err() : E,
    static ok(value: T) : Result<T, E>,
    static err(error: E) : Result<T, E>
}

impl Result<> {
    constructor(error: E) {
        this.error = error
    },
    constructor(value: T) {
        this.value = value
    },
    is_ok() : bool {
        return this.error == null
    },
    is_err() : bool {
        return this.error != null
    },
    unwrap() : T {
        if (this.is_err()) {
            runtime_panic("hoshi-lang: exception unhandled")
            return null
        } else {
            return this.value
        }
    },
    unwrap_err() : E {
        if (this.is_err()) {
            return this.error
        } else {
            runtime_panic("hoshi-lang: attempt to unwrap an error value, but got ok")
            return null
        }
    },
    static ok(value: T) : Result<T, E> {
        return Result<T, E>(value)
    },
    static err(error: E) : Result<T, E> {
        return Result<T, E>(error)
    }
})"