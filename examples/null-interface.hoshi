use lang "builtin"

import puts(str: ptr) : int32 from "builtin"

struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

func main() : int {
    let p = Point(1, 2)
    let obj = lang.NullInterface(p)
    let down_casted = dyn_cast<Point>(obj)
    puts("Null interface validation complete.")
    return 0
}