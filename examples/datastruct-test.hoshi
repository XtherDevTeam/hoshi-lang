// use console "console"
use runtime "runtime"

datastruct Test {
    s: char[256],
    t: unsigned
}

datastruct T {
    field1: int,
    field2: Test
}

func main() : int {
    let t = T(2213, Test())
    runtime.runtime_debug_print_int_1(t.field1)
    let current = t.field1
    t.field1 = 233333
    t.field2.t = 233333
    runtime.runtime_debug_print_int_1(t.field1)
    runtime.runtime_debug_print_int_1(t.field2.t)
    return 0
}
