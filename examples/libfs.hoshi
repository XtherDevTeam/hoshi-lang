use fs "fs"
use str "str"
use console "console"

func main() : int {
    console.print("Home directory: ", fs.Path.home_dir().to_string(), "\n")
    console.print("Current directory: ", fs.Path.current_dir().to_string(), "\n")
    console.print("Temp directory: ", fs.Path.temp_dir().to_string(), "\n")
    let p = fs.Path.temp_dir() / "test.txt"
    console.print("Test file path: ", p.to_string(), "\n")
    p = fs.Path(".")
    if (p.realpath() == null) {
        console.print("Error: Cannot resolve path: ", p.to_string(), "\n")
        return 1
    }
    console.print("Resolved path: ", p.to_string(), "realpath: ", p.realpath().to_string(), "\n")
    p = p / "test_dir1" / "test_dir2"
    if (p.mkdir(true) == false || p.exists() == false) {
        console.print("Error: Cannot create directory: ", p.to_string(), "\n")
        return 1
    }
    console.print("Created directory: ", p.to_string(), "\n")
    fs.Path("./test_dir1").remove(true)
    if (fs.Path("./test_dir1").exists()) {
        console.print("Error: Cannot remove directory: ", p.to_string(), "\n")
        return 1
    }
    console.print("Removed directory: ", p.to_string(), "\n")
    let dirs = fs.Path.current_dir().listdir()
    for (let i = 0; i < dirs.length; i += 1) {
        console.print(dirs[i].to_string(), "\n")
    }
    return 0
}