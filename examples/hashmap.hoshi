use hashMap "hashMap"
use str "str"
use runtime "runtime"
use lang "builtin"

func main() : int {
    let map = hashMap.HashMap<str.Str, int>()
    map["Hello"] = 0xe1751a
    map["World"] = 0x2233ff
    map["Hoshi"] = 0x112233
    map["Language"] = 0x445566
    map["TestCast"] = 0.123
    if (map.size() != 5) {
        runtime.puts("HashMap validation failed: size is not 5")
        return 1
    }
    if (map["Hello"] != 0xe1751a) {
        runtime.puts("HashMap validation failed: value of 'Hello' is not 0xe1751a")
        return 1
    }
    if (map["TestCast"] != 0) {
        runtime.puts("HashMap validation failed: value of 'TestCast' is not 0.123")
        return 1
    }
    let map2 = hashMap.HashMap<str.Str, lang.NullInterface>()
    map2["Hello"] = 0xe1751a
    map2["World"] = "Hello, World!"
    if (map2.contains("Hello") && map2["Hello"] interfaceof int) {
        runtime.puts("HashMap validation: value of 'Hello' is an int")
    } else {
        runtime.puts("HashMap validation: value of 'Hello' is not an int")
        return 1
    }

    runtime.puts("HashMap validation passed")
    return 0
}