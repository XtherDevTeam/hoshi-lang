import puts(str: ptr) : int32 from "builtin"

func main() : int {
    let size = 10
    let x = new int[size](114514, 1919810)
    if (x[0] == 114514 && x[1] == 1919810) {
        puts("new expr validation passed")
    } else {
        puts("new expr validation failed")
        return 1
    }
    x[2] = 2333
    if (x[2] == 2333) {
        puts("store element validation passed")
    } else {
        puts("store element validation failed")
        return 1
    }
    return 0
}