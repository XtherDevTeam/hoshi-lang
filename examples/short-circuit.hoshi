import puts(str: string) : int32 from "builtin"

struct Test {
    a: bool,
    constructor(a: bool)
}

impl Test {
    constructor(a: bool) {
        this.a = a
        return this
    }
}

func main() : int {
    let a = 1, b = 2, c = 3
    if (a == 1 && b == 2 && c == 3) {
        puts("validation passed")
        return 0
    } else {
        puts("validation failed")
        return 1
    }
}