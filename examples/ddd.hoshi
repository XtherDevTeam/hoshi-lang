struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

func main() : int {
    let x = 1.0
    for (let i = 0 ; i < 99999999 ; i += 1) {
        x = (i + i + 2 * i + 1 - 0.379) / x
    }
    return x
}