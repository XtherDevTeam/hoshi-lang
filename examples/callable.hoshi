import puts(str : ptr) : int32 from "builtin"

struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int),
    operator()() : none
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    },
    operator()() : none {
        puts("I was being called upon~ Never let you go~ This is way I did them all~ For a chance at least, to live in your way~")
    }
}

func main() : int {
    let p = Point(1, 2)
    p()
    return 0
}