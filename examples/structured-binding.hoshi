use console "console"
use str "str"

struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

func main() : int {
    let [x, y] = Point(1, 2)
    let [..., z] = Point(114, 514)
    let [a, b, c] = int[3](10, 20, 30)
    console.print(str.format("Structured binding: ({}, {}) (114, {}) [{}, {}, {}]", x, y, z, a, b, c))
    return 0
}