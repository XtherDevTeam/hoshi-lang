use json "json"
use str "str"
use io "io"
use file "file"
use runtime "runtime"
use hashMap "hashMap"
use console "console"

func main() : int {
    let s = str.Str("{\"a\": \"Hello, world!\", \"b\": [1, 2, 3], \"c\": null}")

    let js = json.parse(s)
    if (js.is_err()) {
        runtime.puts(js.unwrap_err().c_str())
        return 1
    }
    console.print("Parsed JSON: ", js.unwrap().to_string(), "\n")
    if (js.unwrap() interfaceof str.Str) {
        let s2 = dyn_cast<str.Str>(js.unwrap())
        runtime.puts(s2.c_str())
    } elif (js.unwrap() interfaceof json.JSONDict) {
        let object = dyn_cast<json.JSONDict>(js.unwrap())
        let s = dyn_cast<str.Str>(object["a"])
        runtime.puts(s.c_str())
        let l = dyn_cast<json.JSONList>(object["b"])
        for (let i = 0; i < l.length; i += 1) {
            let ss = dyn_cast<json.Numeric>(l[i])
            runtime.puts(ss.data.c_str())
        }
        let n = dyn_cast<json.JSONNull>(object["c"])
        if (n != null) {
            runtime.puts("c is null")
        }
    }
    return 0
}