use io "io"
use str "str"
use file "file"
use runtime "runtime"

func main() : int {
    let s = str.Str("Hello, world!")
    let i = io.ArrayBuffer(1024) as file.AbstractFile
    i.write(s.data)
    let cursor = i.tell()
    runtime.runtime_debug_print_int_1(cursor)
    i.seek(0, 0)
    let end_pos = 4
    let start_pos = 0
    let buf = i.read(end_pos - start_pos + 1)
    runtime.puts(runtime.runtime_get_string_array_data_pointer(buf.data))
    i.close()
    return 0
}