use runtime "runtime"

concept is_addable<A>(a: A, b: A) {
    a + b
}

concept custom_concept<A, B>(a: A, b: B) {
    satisfy is_addable<A>
    satisfy is_addable<B>
    a - b
}

func test<A satisfy(custom_concept<A, int>)>(a: A, b: A) : int {
    return a + b
}

func main() : int {
    let a = 1
    let b = 2
    return test(a, b) - 3
}
