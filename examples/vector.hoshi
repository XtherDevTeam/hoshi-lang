use vec "vec"
use lang "builtin"
import puts(str: ptr) : int32 from "builtin"

func main() : int {
    puts("compiliation success")
    let v = vec.Vec<int>(0)
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    for (let i = 0;i < v.length; i += 1) {
        if (v[i] != i + 1) {
            puts("vector validation failed: push")
            return 1
        }
    }
    v.shrink_to_fit()
    if (v.capacity != 5) {
        puts("vector validation failed: shrink_to_fit")
        return 1
    }
    v.pop()
    v.pop()
    if (v.length != 3) {
        puts("vector validation failed: pop")
        return 1
    }
    v.clear()
    if (v.length != 0) {
        puts("vector validation failed: clear")
        return 1
    }
    puts("vector validation passed")
    return 0
}