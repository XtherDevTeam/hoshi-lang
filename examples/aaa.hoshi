interface Addable {
    add() : int
}

struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

impl Point : Addable {
    add() : int {
        return this.x + this.y
    }
}

func add_inv<T impl Addable>(a: T) : int {
    let addable = Addable(a)
    let res = addable.add()
    return res
}

func main() : int {
    let p1 = Point(1, 2)
    let result = add_inv(p1)
    return result
}