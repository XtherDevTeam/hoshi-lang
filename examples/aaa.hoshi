struct Point {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl Point {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

concept Addable2<T>(a: T) {
    a.x + a.y
}

func add_inv<T satisfy(Addable2<T>)>(a: T) : int {
    return a.x + a.y
}

func main() : int {
    let p1 = Point(1, 2)
    let result = add_inv(p1)
    return result
}
