import puts(str: string) : int32 from "builtin"

struct Test {
    a: bool,
    constructor(a: bool)
}

impl Test {
    constructor(a: bool) {
        this.a = a
    }
}

interface ITest {
    fetch() : bool
}

impl Test : ITest {
    fetch() : bool {
        return this.a
    }
}

func main() : int {
    for (let i = 0; i < 233; i += 1) {
        let arr = ITest[2](Test(true), Test(false))
    }
    return 0
}