struct aaa {
    x: int,
    y: int,
    constructor(x: int, y: int)
}

impl aaa {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

func test1() : int {
    return 114514
}

func test() : int {
    let i = 0
    let b = 1 + 1 + 4 + 514.00
    if (b == 520.00) {
        return 2233
    }
    return i + b
}

func test2(cond: bool) : int {
    let a = 111
    let b = 1123
    // cond is uncertain
    if (b == 1123) {
        a += 223
    } else {
        a = 224
    }
    return a
}