use test1 "examples/test1.hoshi"

interface Test {
    yield() : int
}

struct aaa {
    x: int,
    y: int,
    constructor(x: int, y: int),
    a(): none
}

impl aaa {
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    },
    a() : none {
        this.x += 1
        return
    }
}

impl aaa : Test {
    yield() : int {
        return this.x + this.y
    }
}

impl aaa : test1.ExternalInterface {
    test() : none {
        this.a()
        return
    }
}

func test() : int {
    let i = 0
    let b = 1 + 1 + 4 + 514.00
    if (b == 520.00) {
        return 2233
    }
    return i + b
}

func test2(cond: bool) : int {
    let a = 111
    let b = 1123
    // cond is uncertain
    if (b == 1123) {
        a += 223
    } else {
        a = 224
    }
    return a
}

func test3() : int {
    let x = aaa(1, 2)
    let y = Test(x)
    return y.yield()
}