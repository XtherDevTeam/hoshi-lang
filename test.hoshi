use sqlite "sqlite"
use str "str"
use lang "builtin"
use vec "vec"
use types "types"
use crypto "crypto"
use fs "fs"
use json "json"
use lang "builtin"

enum ResultCode {
    Success,
    DatabaseNotInitialized,
    UserAlreadyExists,
    UserNotFound,
    InvalidQuery
}

struct DataProviderHelper {
    constructor(),
    static convert_row_to_user(row: sqlite.SQLRowResult): types.User,
    static convert_row_to_package_information(row: sqlite.SQLRowResult): types.PackageInformation,
    static convert_row_to_config(row: sqlite.SQLRowResult): types.Config,
    static convert_row_to_package_version(row: sqlite.SQLRowResult): types.PackageVersion,
    static convert_row_to_artifact(row: sqlite.SQLRowResult): types.Artifact
}

impl DataProviderHelper {
    constructor() {
        return this
    }
    static convert_row_to_user(row: sqlite.SQLRowResult): types.User {
        return types.User().set_id(dyn_cast<int>(row["id"])).set_username(dyn_cast<str.Str>(row["username"])).set_password_salted(dyn_cast<str.Str>(row["password_salted"])).set_email(dyn_cast<str.Str>(row["email"])).set_description(dyn_cast<str.Str>(row["description"])).set_permission(dyn_cast<int>(row["permission"])).set_avatar_path(dyn_cast<str.Str>(row["avatar_path"])).set_avatar_mime(dyn_cast<str.Str>(row["avatar_mime"]))
    }
    static convert_row_to_package_information(row: sqlite.SQLRowResult): types.PackageInformation {
        return types.PackageInformation().set_id(dyn_cast<int>(row["id"])).set_name(dyn_cast<str.Str>(row["name"])).set_author(dyn_cast<str.Str>(row["author"])).set_description(dyn_cast<str.Str>(row["description"])).set_repository(dyn_cast<str.Str>(row["repository"])).set_license(dyn_cast<str.Str>(row["license"])).set_readme(dyn_cast<str.Str>(row["readme"]))
    }
    static convert_row_to_config(row: sqlite.SQLRowResult): types.Config {
        return types.Config().set_host(dyn_cast<str.Str>(row["host"])).set_port(dyn_cast<int>(row["port"])).set_artifacts_dir(dyn_cast<str.Str>(row["artifacts_dir"])).set_secret_key(dyn_cast<str.Str>(row["secret_key"]))
    }
    static convert_row_to_package_version(row: sqlite.SQLRowResult): types.PackageVersion {
        return types.PackageVersion().set_id(dyn_cast<int>(row["id"])).set_package_id(dyn_cast<int>(row["package_id"])).set_tag_name(dyn_cast<str.Str>(row["tag_name"])).set_revision_notes(dyn_cast<str.Str>(row["revision_notes"])).set_artifacts(dyn_cast<str.Str>(row["artifacts"])).set_dependencies(dyn_cast<str.Str>(row["dependencies"])).set_created_at(dyn_cast<str.Str>(row["created_at"]))
    }
    static convert_row_to_artifact(row: sqlite.SQLRowResult): types.Artifact {
        return types.Artifact().set_id(dyn_cast<int>(row["id"])).set_package_id(dyn_cast<int>(row["package_id"])).set_unique_id(dyn_cast<str.Str>(row["unique_id"])).set_version(dyn_cast<str.Str>(row["version"])).set_filename(dyn_cast<str.Str>(row["filename"])).set_mime(dyn_cast<str.Str>(row["mime"])).set_destinations(dyn_cast<str.Str>(row["destinations"])).set_platform(dyn_cast<str.Str>(row["platform"])).set_arch(dyn_cast<str.Str>(row["arch"]))
    }
}

struct DataProvider {
    db: sqlite.Database,
    path: str.Str,
    constructor(path: str.Str),
    init(): bool,
    check_if_initialized(): bool,
    add_user(username: str.Str, password: str.Str): ResultCode,
    auth_user(username: str.Str, password: str.Str): lang.Result<int, ResultCode>,
    update_user_password(id: int, new_password: str.Str): ResultCode,
    delete_user(id: int): ResultCode,
    update_user(id: int, description: str.Str, email: str.Str, permission: int): ResultCode,
    register_package(name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str): ResultCode,
    get_user_by_id(id: int): lang.Result<types.User, ResultCode>,
    get_user_by_username(username: str.Str): lang.Result<types.User, ResultCode>,
    get_user_packages(id: int): lang.Result<vec.Vec<types.PackageInformation>, ResultCode>,
    get_package_list(): lang.Result<vec.Vec<types.PackageInformation>, ResultCode>,
    get_package_by_name(name: str.Str): lang.Result<types.PackageInformation, ResultCode>,
    get_package_by_id(id: int): lang.Result<types.PackageInformation, ResultCode>,
    update_package(id: int, name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str): lang.Result<bool, ResultCode>,
    delete_package(id: int): lang.Result<bool, ResultCode>,
    get_package_versions(id: int): lang.Result<vec.Vec<types.PackageVersion>, ResultCode>,
    get_package_version(id: int, tag_name: str.Str): lang.Result<types.PackageVersion, ResultCode>,
    add_package_version(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str): ResultCode,
    update_package_version(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str): ResultCode,
    delete_package_version(package_id: int, tag_name: str.Str): ResultCode,
    add_artifact(package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, destinations: str.Str, platform: str.Str, arch: str.Str): ResultCode,
    get_artifact_by_unique_id(unique_id: str.Str): lang.Result<types.Artifact, ResultCode>,
    get_artifact_by_name(package_id: int, version: str.Str, filename: str.Str): lang.Result<types.Artifact, ResultCode>,
    get_artifacts_by_package_version(package_id: int, version: str.Str): lang.Result<vec.Vec<types.Artifact>, ResultCode>,
    delete_artifact(unique_id: str.Str): ResultCode,
    get_config(): lang.Result<types.Config, ResultCode>,
    update_config(host: str.Str, port: int, artifacts_dir: str.Str, secret_key: str.Str): lang.Result<bool, ResultCode>,
    search_users(query: types.UserQueryCondition, range: types.GeneralRangeCondition): lang.Result<vec.Vec<types.User>, ResultCode>,
    search_packages(query: types.PackageQueryCondition, range: types.GeneralRangeCondition): lang.Result<vec.Vec<types.PackageInformation>, ResultCode>,
    update_user_avatar(id: int, path: str.Str, mime: str.Str): ResultCode
}

impl DataProvider {
    constructor(path: str.Str) {
        this.path = path
        this.db = sqlite.open(path).unwrap("database open failure")
    }
    init(): bool {
        if (this.check_if_initialized()) {
            return true
        }
        let fp = fs.open("share/scheme.sql", "r+").unwrap()
        if (this.db.execute_batch(str.Str(fp.read(fp.size()).data)).is_err()) {
            return false
        }
        return true
    }
    check_if_initialized(): bool {
        let result = this.db.execute("select * from config")
        return result.is_err() == false
    }
    add_user(username: str.Str, password: str.Str): ResultCode {
        let salted = str.format("{}:tsuki-server", password)
        let salted_md5 = crypto.hash.Hash.md5().feed(salted.data, salted.length).final().hexdigest()
        let query = this.db.execute("insert into users (username, password_salted, avatar_path, avatar_mime) values (?,?, ?, ?)", username, salted_md5, str.Str("template/default_avatar.jpg"), str.Str("image/jpeg"))
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    auth_user(username: str.Str, password: str.Str): lang.Result<int, ResultCode> {
        let salted = str.format("{}:tsuki-server", password)
        let salted_md5 = crypto.hash.Hash.md5().feed(salted.data, salted.length).final().hexdigest()
        let query = this.db.execute("select id from users where username = ? and password_salted = ?", username, salted_md5)
        if (query.is_err()) {
            return lang.Result<int, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let [result, err] = query.unwrap().fetch()
        if (err != null) {// mismatch username or password
            return lang.Result<int, ResultCode>.err(ResultCode.InvalidQuery)
        } else {
            return lang.Result<int, ResultCode>.ok(dyn_cast<int>(result["id"]))
        }
    }
    update_user_password(id: int, new_password: str.Str): ResultCode {
        let salted = str.format("{}:tsuki-server", new_password)
        let salted_md5 = crypto.hash.Hash.md5().feed(salted.data, salted.length).final().hexdigest()
        let query = this.db.execute("update users set password_salted = ? where id = ?", salted_md5, id)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    delete_user(id: int): ResultCode {
        let query = this.db.execute("delete from users where id = ?", id)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    update_user(id: int, description: str.Str, email: str.Str, permission: int): ResultCode {
        let query = this.db.execute("update users set description = ?, email = ?, permission = ? where id = ?", description, email, permission, id)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    register_package(name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str): ResultCode {
        let query = this.db.execute("insert into packages (name, author, description, repository, license, readme) values (?,?,?,?, ?, ?)", name, author, description, repository, license, readme)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    get_user_by_id(id: int): lang.Result<types.User, ResultCode> {
        let query = this.db.execute("select * from users where id = ?", id)
        if (query.is_err()) {
            return lang.Result<types.User, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.User, ResultCode>.err(ResultCode.UserNotFound)
        }
        let row = result.unwrap()[0]
        let user = DataProviderHelper.convert_row_to_user(row)
        return lang.Result<types.User, ResultCode>.ok(user)
    }
    get_user_by_username(username: str.Str): lang.Result<types.User, ResultCode> {
        let query = this.db.execute("select * from users where username = ?", username)
        if (query.is_err()) {
            return lang.Result<types.User, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.User, ResultCode>.err(ResultCode.UserNotFound)
        }
        let row = result.unwrap()[0]
        let user = DataProviderHelper.convert_row_to_user(row)
        return lang.Result<types.User, ResultCode>.ok(user)
    }
    get_user_packages(id: int): lang.Result<vec.Vec<types.PackageInformation>, ResultCode> {
        let query = this.db.execute("select * from packages where author_id = ?", id)
        if (query.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let packages = vec.Vec<types.PackageInformation>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            let row = result.unwrap()[i]
            let package = DataProviderHelper.convert_row_to_package_information(row)
            packages.push(package)
        }
        return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.ok(packages)
    }
    get_package_list(): lang.Result<vec.Vec<types.PackageInformation>, ResultCode> {
        let query = this.db.execute("select * from packages")
        if (query.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let packages = vec.Vec<types.PackageInformation>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            let row = result.unwrap()[i]
            let package = DataProviderHelper.convert_row_to_package_information(row)
            packages.push(package)
        }
        return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.ok(packages)
    }
    get_package_by_name(name: str.Str): lang.Result<types.PackageInformation, ResultCode> {
        let query = this.db.execute("select * from packages where name = ?", name)
        if (query.is_err()) {
            return lang.Result<types.PackageInformation, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.PackageInformation, ResultCode>.err(ResultCode.UserNotFound)
        }
        let row = result.unwrap()[0]
        let package = DataProviderHelper.convert_row_to_package_information(row)
        return lang.Result<types.PackageInformation, ResultCode>.ok(package)
    }
    get_package_by_id(id: int): lang.Result<types.PackageInformation, ResultCode> {
        let query = this.db.execute("select * from packages where id = ?", id)
        if (query.is_err()) {
            return lang.Result<types.PackageInformation, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.PackageInformation, ResultCode>.err(ResultCode.UserNotFound)
        }
        let row = result.unwrap()[0]
        let package = DataProviderHelper.convert_row_to_package_information(row)
        return lang.Result<types.PackageInformation, ResultCode>.ok(package)
    }
    update_package(id: int, name: str.Str, author: str.Str, description: str.Str, repository: str.Str, license: str.Str, readme: str.Str): lang.Result<bool, ResultCode> {
        let query = this.db.execute("update packages set name = ?, author = ?, description = ?, repository = ?, license = ?, readme = ? where id = ?", name, author, description, repository, license, readme, id)
        if (query.is_err()) {
            return lang.Result<bool, ResultCode>.err(ResultCode.InvalidQuery)
        }
        return lang.Result<bool, ResultCode>.ok(true)
    }
    delete_package(id: int): lang.Result<bool, ResultCode> {
        // Cleanup artifacts from filesystem
        let artifacts_query = this.db.execute("select destinations from artifacts where package_id = ?", id)
        if (artifacts_query.is_ok()) {
            let [res, err] = artifacts_query.unwrap().fetch_all()
            if (err != null) {
                return lang.Result<bool, ResultCode>.err(ResultCode.InvalidQuery)
            }
            for (let i = 0; i < res.length; i += 1) {
                let row = res[i]
                let dest = dyn_cast<str.Str>(row["destinations"])
                fs.Path(dest).remove()
            }
        }
        let query = this.db.execute("delete from packages where id = ?", id)
        if (query.is_err()) {
            return lang.Result<bool, ResultCode>.err(ResultCode.InvalidQuery)
        }
        this.db.execute("delete from package_versions where package_id = ?", id)
        this.db.execute("delete from artifacts where package_id = ?", id)
        return lang.Result<bool, ResultCode>.ok(true)
    }
    get_package_versions(id: int): lang.Result<vec.Vec<types.PackageVersion>, ResultCode> {
        let query = this.db.execute("select * from package_versions where package_id = ? order by created_at desc", id)
        if (query.is_err()) {
            return lang.Result<vec.Vec<types.PackageVersion>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.PackageVersion>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let versions = vec.Vec<types.PackageVersion>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            versions.push(DataProviderHelper.convert_row_to_package_version(result.unwrap()[i]))
        }
        return lang.Result<vec.Vec<types.PackageVersion>, ResultCode>.ok(versions)
    }
    get_package_version(id: int, tag_name: str.Str): lang.Result<types.PackageVersion, ResultCode> {
        let query = this.db.execute("select * from package_versions where package_id = ? and tag_name = ?", id, tag_name)
        if (query.is_err()) {
            return lang.Result<types.PackageVersion, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.PackageVersion, ResultCode>.err(ResultCode.InvalidQuery)
        }
        return lang.Result<types.PackageVersion, ResultCode>.ok(DataProviderHelper.convert_row_to_package_version(result.unwrap()[0]))
    }
    add_package_version(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str): ResultCode {
        let query = this.db.execute("insert into package_versions (package_id, tag_name, revision_notes, artifacts, dependencies) values (?, ?, ?, ?, ?)", package_id, tag_name, revision_notes, artifacts, dependencies)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    update_package_version(package_id: int, tag_name: str.Str, revision_notes: str.Str, artifacts: str.Str, dependencies: str.Str): ResultCode {
        let query = this.db.execute("update package_versions set revision_notes = ?, artifacts = ?, dependencies = ? where package_id = ? and tag_name = ?", revision_notes, artifacts, dependencies, package_id, tag_name)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    delete_package_version(package_id: int, tag_name: str.Str): ResultCode {
        // Cleanup artifacts from filesystem
        let artifacts_query = this.db.execute("select destinations from artifacts where package_id = ? and version = ?", package_id, tag_name)
        if (artifacts_query.is_ok()) {
            let res = artifacts_query.unwrap().fetch_all()
            if (res.is_ok()) {
                let rows = res.unwrap()
                for (let i = 0; i < rows.length; i += 1) {
                    let row = rows[i]
                    let dest = dyn_cast<str.Str>(row["destinations"])
                    fs.Path(dest).remove()
                }
            }
        }
        let query = this.db.execute("delete from package_versions where package_id = ? and tag_name = ?", package_id, tag_name)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        this.db.execute("delete from artifacts where package_id = ? and version = ?", package_id, tag_name)
        return ResultCode.Success
    }
    add_artifact(package_id: int, unique_id: str.Str, version: str.Str, filename: str.Str, mime: str.Str, destinations: str.Str, platform: str.Str, arch: str.Str): ResultCode {
        let query = this.db.execute("insert into artifacts (package_id, unique_id, version, filename, mime, destinations, platform, arch) values (?, ?, ?, ?, ?, ?, ?, ?)", package_id, unique_id, version, filename, mime, destinations, platform, arch)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    get_artifact_by_unique_id(unique_id: str.Str): lang.Result<types.Artifact, ResultCode> {
        let query = this.db.execute("select * from artifacts where unique_id = ?", unique_id)
        if (query.is_err()) {
            return lang.Result<types.Artifact, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.Artifact, ResultCode>.err(ResultCode.InvalidQuery)
        }
        return lang.Result<types.Artifact, ResultCode>.ok(DataProviderHelper.convert_row_to_artifact(result.unwrap()[0]))
    }
    get_artifact_by_name(package_id: int, version: str.Str, filename: str.Str): lang.Result<types.Artifact, ResultCode> {
        let query = this.db.execute("select * from artifacts where package_id = ? and version = ? and filename = ?", package_id, version, filename)
        if (query.is_err()) {
            return lang.Result<types.Artifact, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.Artifact, ResultCode>.err(ResultCode.InvalidQuery)
        }
        return lang.Result<types.Artifact, ResultCode>.ok(DataProviderHelper.convert_row_to_artifact(result.unwrap()[0]))
    }
    get_artifacts_by_package_version(package_id: int, version: str.Str): lang.Result<vec.Vec<types.Artifact>, ResultCode> {
        let query = this.db.execute("select * from artifacts where package_id = ? and version = ?", package_id, version)
        if (query.is_err()) {
            return lang.Result<vec.Vec<types.Artifact>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.Artifact>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let artifacts = vec.Vec<types.Artifact>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            artifacts.push(DataProviderHelper.convert_row_to_artifact(result.unwrap()[i]))
        }
        return lang.Result<vec.Vec<types.Artifact>, ResultCode>.ok(artifacts)
    }
    delete_artifact(unique_id: str.Str): ResultCode {
        let query = this.db.execute("delete from artifacts where unique_id = ?", unique_id)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
    get_config(): lang.Result<types.Config, ResultCode> {
        let query = this.db.execute("select * from config")
        if (query.is_err()) {
            return lang.Result<types.Config, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query.unwrap().fetch_all()
        if (result.is_err() || result.unwrap().length == 0) {
            return lang.Result<types.Config, ResultCode>.err(ResultCode.DatabaseNotInitialized)
        }
        let row = result.unwrap()[0]
        let config = DataProviderHelper.convert_row_to_config(row)
        return lang.Result<types.Config, ResultCode>.ok(config)
    }
    update_config(host: str.Str, port: int, artifacts_dir: str.Str, secret_key: str.Str): lang.Result<bool, ResultCode> {
        let query = this.db.execute("update config set host = ?, port = ?, artifacts_dir = ?, secret_key = ? where id = 1", host, port, artifacts_dir, secret_key)
        if (query.is_err()) {
            return lang.Result<bool, ResultCode>.err(ResultCode.InvalidQuery)
        }
        return lang.Result<bool, ResultCode>.ok(true)
    }
    search_users(query: types.UserQueryCondition, range: types.GeneralRangeCondition): lang.Result<vec.Vec<types.User>, ResultCode> {
        let sql = str.Str("select * from users where 1=1")
        let args = vec.Vec<sqlite.SQLBindable>()
        if (query.has_username_like()) {
            sql = sql + " and username like ?"
            args.push(str.format("%{}%", query.username_like))
        }
        if (query.has_email_like()) {
            sql = sql + " and email like ?"
            args.push(str.format("%{}%", query.email_like))
        }
        if (query.has_permission()) {
            sql = sql + " and permission = ?"
            args.push(query.permission)
        }
        sql = sql + " limit ? offset ?"
        if (range.has_page_size()) {
            args.push(range.page_size)
        } else {
            args.push(10)
        }
        if (range.has_page_offset()) {
            args.push(range.page_offset)
        } else {
            args.push(0)
        }
        let query_res = this.db.execute(sql, args)
        if (query_res.is_err()) {
            return lang.Result<vec.Vec<types.User>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query_res.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.User>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let users = vec.Vec<types.User>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            users.push(DataProviderHelper.convert_row_to_user(result.unwrap()[i]))
        }
        return lang.Result<vec.Vec<types.User>, ResultCode>.ok(users)
    }
    search_packages(query: types.PackageQueryCondition, range: types.GeneralRangeCondition): lang.Result<vec.Vec<types.PackageInformation>, ResultCode> {
        let sql = str.Str("select * from packages where 1=1")
        let args = vec.Vec<sqlite.SQLBindable>()
        if (query.has_name_like()) {
            sql = sql + " and name like ?"
            args.push(str.format("%{}%", query.name_like))
        }
        if (query.has_description_like()) {
            sql = sql + " and description like ?"
            args.push(str.format("%{}%", query.description_like))
        }
        if (query.has_author_id()) {
            sql = sql + " and author_id = ?"
            args.push(query.author_id)
        }
        sql = sql + " limit ? offset ?"
        if (range.has_page_size()) {
            args.push(range.page_size)
        } else {
            args.push(10)
        }
        if (range.has_page_offset()) {
            args.push(range.page_offset)
        } else {
            args.push(0)
        }
        let query_res = this.db.execute(sql, args)
        if (query_res.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let result = query_res.unwrap().fetch_all()
        if (result.is_err()) {
            return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.err(ResultCode.InvalidQuery)
        }
        let packages = vec.Vec<types.PackageInformation>()
        for (let i = 0; i < result.unwrap().length; i += 1) {
            packages.push(DataProviderHelper.convert_row_to_package_information(result.unwrap()[i]))
        }
        return lang.Result<vec.Vec<types.PackageInformation>, ResultCode>.ok(packages)
    }
    update_user_avatar(id: int, path: str.Str, mime: str.Str): ResultCode {
        let query = this.db.execute("update users set avatar_path = ?, avatar_mime = ? where id = ?", path, mime, id)
        if (query.is_err()) {
            return ResultCode.InvalidQuery
        }
        return ResultCode.Success
    }
}

